        <dictScrap type="liebermann"><hi rend="bold">forbugan</hi> <ref type="lawCode" target="law:ICn">I Cn</ref> 1c <ref type="lawCode" target="law:D">D</ref> | <hi rend="italic"><ref type="abbreviation" target="gram:Optativ"><abbr>op</abbr></ref></hi> 3: ~ge <ref type="lawCode" target="law:Hu">Hu</ref> 6. <ref type="lawCode" target="law:IIIEg">III Eg</ref> 7 = <ref type="lawCode" target="law:IICn">II Cn</ref> 25. <ref type="lawCode" target="law:IAtr">I Atr</ref> 1,7 = <ref type="lawCode" target="law:IICn">II Cn</ref> 30,6 (~! <ref type="lawCode" target="law:MsA">A</ref>). <ref type="lawCode" target="law:VAtr">V Atr</ref> 10 = VI 11 = <ref type="lawCode" target="law:ICn">I Cn</ref> 6,3. <ref type="lawCode" target="law:Northu">Northu</ref> 4. 6. 44; ~ga <ref type="lawCode" target="law:IICn">II Cn</ref> 25 <ref type="lawCode" target="law:B">B</ref> | <hi rend="italic"><ref type="abbreviation" target="gram:Plural"><abbr>pl</abbr></ref></hi> 1: ~ <ref type="lawCode" target="law:VIAtr">VI Atr</ref> 1. — <hi rend="bold">1</hi>) <hi rend="italic">vermeiden, unterlassen:</hi> unrihthæmed <ref type="lawCode" target="law:VAtr">V Atr</ref> 10 = VI 11 = <ref type="lawCode" target="law:ICn">I Cn</ref> 6,3; hæðendom <ref type="lawCode" target="law:VIAtr">VI Atr</ref> 1 = <ref type="lawCode" target="law:ICn">I Cn</ref> 1c <ref type="lawCode" target="law:D">D</ref> <hi rend="bold">2</hi>) <hi rend="italic">zu befolgen widerrechtlich unterlassen</hi> <hi rend="bold">a</hi>) geban <ref type="lawCode" target="law:Northu">Northu</ref> 4. 6 <hi rend="bold">b</hi>) <hi rend="italic">zu besuchen versäumen:</hi> sinoð 44; gemot <ref type="lawCode" target="law:IIIEg">III Eg</ref> 7 = <ref type="lawCode" target="law:IICn">II Cn</ref> 25; <hi rend="italic">der Rechtspflicht entfliehend, vermeiden:</hi> riht <hi rend="italic">Rechtserfüllung</hi> <ref type="lawCode" target="law:Hu">Hu</ref> 6; ordal <ref type="lawCode" target="law:IAtr">I Atr</ref> 1,7 = <ref type="lawCode" target="law:IICn"