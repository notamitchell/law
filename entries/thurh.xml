          <sense n="6"><hi rend="italic"><ref type="abbreviation" target="gram:auf"><abbr>auf</abbr></ref> die Art von, in .. Weise</hi> + <hi rend="italic"><ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref> <ref type="abbreviation" target="gram:Substantiv"><abbr>sbst</abbr></ref></hi> [<hi rend="italic">statt Eigenschaftsadv.</hi>]; ~ æhlyp <hi rend="italic">gewalttätig</hi> <ref type="lawCode" target="law:VAtr">V Atr</ref> 31,1; ~ riht <ref type="lawCode" target="law:Iudex">Iudex</ref> 2, per aequitatem <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref>;</hi> ~ mildheortnesse <hi rend="italic">barmherziger Weise <ref type="abbreviation" target="gram:ebenda"><abbr>ebd.</abbr></ref></hi> | ~ ænig þing <hi rend="italic">in <ref type="abbreviation" target="gram:etwas"><abbr>etwas</abbr></ref>, irgendwie</hi> <ref type="lawCode" target="law:EGu">EGu</ref> 12</sense>
