        <dictScrap type="liebermann"><lbl type="language">L</lbl> <hi rend="bold">suspendium</hi> <hi rend="bold">1</hi>) <hi rend="italic">Erhenken;</hi> subeat ~ <ref type="lawCode" target="law:IICn">II Cn</ref> 35 Cons, gebuge hengenne <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref>, <ref type="abbreviation" target="gram:irrig"><abbr>irrig</abbr></ref> von</hi> hengen <hi rend="italic">die <ref type="abbreviation" target="gram:Bedeutung"><abbr>Bed.</abbr></ref></hi> 2 <hi rend="italic">wählend</hi> (<hi rend="italic">um den Unsinn zu vermeiden, führt ein Verbesserer <ref type="abbreviation" target="gram:Negation"><abbr>Negation</abbr></ref> ein</hi>); captionem (<hi rend="italic">Gefängnis</hi>) <hi rend="italic">richtig</hi> In; carcannum (<hi rend="italic">Stock zur Fesselung</hi>) <ref type="lawCode" target="law:Quadr">Q</ref>, <hi rend="italic">der <ref type="abbreviation" target="gram:aber"><abbr>aber</abbr></ref> laut</hi> <ref type="lawCode" target="law:Hn">Hn</ref> 65,5 <hi rend="italic">anfangs</hi> hengen <hi rend="italic"><ref type="abbreviation" target="gram:unverstanden"><abbr>unverstanden</abbr></ref> ins Latein übernommen hatte</hi> <hi rend="bold">2</hi>) <hi rend="italic">Galgen;</hi> in ~ mittere <ref type="lawCode" target="law:Af">Af</ref> 35,2 <ref type="lawCode" target="law:Quadr">Q</ref>, on hengenne (<hi rend="italic">Gefängnis</hi>) alecgan <hi rend="italic"><ref type="abbreviation" target="gram:falsch"><abbr>falsch</abbr></ref> <ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref>;</hi> suspenso, suspendere <hi rend="italic"><ref type="abbreviation" target="gram:Variante"><abbr>Var.</abbr></ref></hi></dictScrap>
