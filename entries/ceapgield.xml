        <dictScrap type="liebermann"><hi rend="bold">ceapgield</hi> <hi rend="bold">1</hi>) <hi rend="italic">Ersatzgeld, eingeklagter Sachwert;</hi> ~gild <ref type="lawCode" target="law:VIAs">VI As</ref> 6,4; ~geld <ref type="lawCode" target="law:WlArt">Wl art</ref> 8,3; <hi rend="italic"><ref type="abbreviation" target="gram:Variante"><abbr>Var.</abbr></ref></hi> chap-, schap-, chep-, -gelt, -geldt; <hi rend="italic"><ref type="abbreviation" target="gram:franzosisch"><abbr>fz</abbr></ref>:</hi> chapgield | <hi rend="italic"><ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref>:</hi> ~ildes <ref type="lawCode" target="law:VIAs">VI As</ref> 8,8; <hi rend="italic"><ref type="abbreviation" target="gram:verderbt"><abbr>verderbt</abbr></ref></hi> þæs ~gyld <ref type="lawCode" target="law:Ld">Ld</ref> <ref type="lawCode" target="law:Quadr">Q</ref> <hi rend="italic">statt</hi> ceapes II 24,1 | <hi rend="italic"><ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref>:</hi> ~ilde <ref type="lawCode" target="law:IIAs">II As</ref> 21. VI 1,4 | <hi rend="italic"><ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref>:</hi> ~ild <ref type="lawCode" target="law:IIAs">II As</ref> 3 (~gyld BSo). 19. VI 6,4; ~gyld VI 1,1. <ref type="lawCode" target="law:Hu">Hu</ref> 2,1. <ref type="lawCode" target="law:IIIEg">III Eg</ref> 7,1 (cep- <ref type="lawCode" target="law:MsA">A</ref>) = <ref type="lawCode" target="law:IICn">II Cn</ref> 25,1 BA (~gild <ref type="lawCode" target="law:G">G</ref>; ~geld In). <ref type="lawCode" target="law:IVEg">IV Eg</ref> 11. <ref type="lawCode" target="law:IAtr">I Atr</ref> 1,7 = <ref type="lawCode" target="law:IICn">II Cn</ref> 30,6 (~gild <ref type="lawCode" target="law:MsA">A</ref>) ‖ <hi rend="italic"><ref type="abbreviation" target="gram:Lateinisch"><abbr>lat</abbr></ref>: <ref type="abbreviation" target="gram:zumeist"><abbr>zumeist</abbr></ref></hi> ~gildum <ref type="lawCode" target="law:Quadr">Q</ref> [<hi rend="italic"><ref type="abbreviation" target="gram:neben"><abbr>neben</abbr></ref></hi> captale <hi rend="italic"><ref type="abbreviation" target="gram:sieheDort"><abbr>s. d.</abbr></ref>; <ref type="abbreviation" target="gram:doch"><abbr>doch</abbr></ref> <ref type="abbreviation" target="gram:erklart"><abbr>erklärt</abbr></ref></hi> (per)solutio <ref type="lawCode" target="law:Quadr">Q</ref> (<ref type="lawCode" target="law:VIAs">VI As</ref> 8,8) <ref type="lawCode" target="law:IICn">II Cn</ref> 25,1]; capitalis census Cons; pretium <ref type="lawCode" target="law:Hu">Hu</ref> 2,1 Cons; quod exegit <hi rend="italic"><ref type="abbreviation" target="gram:erklart"><abbr>erklärt</abbr></ref></hi> <ref type="lawCode" target="law:IICn">II Cn</ref> 30,6 In; quod calumniatum est <ref type="lawCode" target="law:WlArt">Wl art</ref> 8,3 <hi rend="bold">2</hi>) forstolene orf ⁊ orfes ceapgyld <hi rend="italic">‘nochmaliger Sachwert <ref type="abbreviation" target="gram:neben"><abbr>neben</abbr></ref> dem Eingeklagten’</hi> <ref type="lawCode" target="law:IVEg">IV Eg</ref> 11 [<hi rend="italic">wenn hier nicht</hi> ⁊ = <hi rend="italic">‘beziehungsweise, <ref type="abbreviation" target="gram:dasIst"><abbr>d. i.</abbr></ref> <ref type="abbreviation" target="gram:falls"><abbr>falls</abbr></ref> Gestohlenes selbst unterging’</hi>]</dictScrap>
