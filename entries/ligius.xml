        <dictScrap type="liebermann"><lbl type="language">L</lbl> <hi rend="bold">ligius</hi> <hi rend="italic">vasallitisch gebunden und zwar unbeschränkt <ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref></hi> (= <hi rend="italic">fester, <ref type="abbreviation" target="gram:weiter"><abbr>weiter</abbr></ref> hinaus, <ref type="abbreviation" target="gram:uber"><abbr>über</abbr></ref></hi>) <hi rend="italic">andere Vasallitätsverhältnisse</hi> = <hi rend="italic">diesem Herrn mehr <ref type="abbreviation" target="gram:als"><abbr>als</abbr></ref> allen <ref type="abbreviation" target="gram:ubrige"><abbr>übrigen</abbr></ref> Herren vasallitisch verpflichtet</hi> <hi rend="bold">a</hi>) legius <hi rend="italic"><ref type="abbreviation" target="gram:vom"><abbr>vom</abbr></ref> Manne gesagt</hi> <ref type="lawCode" target="law:Hn">Hn</ref> 43,6; 6a; lig~ <hi rend="italic"><ref type="abbreviation" target="gram:Variante"><abbr>Var.</abbr></ref></hi> 32,2. 55,2; 3b. 61,6b. 82,5 <hi rend="bold">b</hi>) ~ dominus <hi rend="italic">unbedingter Herr</hi> <ref type="lawCode" target="law:LeisWl">Leis Wl</ref> 20,2 L, lige <hi rend="italic"><ref type="abbreviation" target="gram:ubersetzend"><abbr>übsnd</abbr></ref></hi> | <hi rend="bold">ligie</hi>, <hi rend="italic"><ref type="abbreviation" target="gram:adverb"><abbr>adv</abbr></ref>, unbedingt untertan</hi> <ref type="lawCode" target="law:ECf">ECf</ref> 25; <hi rend="italic"><ref type="abbreviation" target="gram:Variante"><abbr>Var.</abbr></ref></hi> legie</dictScrap>
      </entry>
