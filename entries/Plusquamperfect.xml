        <dictScrap type="liebermann"><hi rend="bold"><hi rend="italic">Plusquamperfect</hi></hi> <hi rend="italic">ausgedrückt <ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref></hi> <hi rend="bold">1</hi>) <hi rend="italic">Hilfszeitwort:</hi> hit gelæst wære, þæt (<hi rend="italic">was</hi>) he beboden hæfde <ref type="lawCode" target="law:IIEw">II Ew</ref> 1 <hi rend="bold">2</hi>) <hi rend="italic">Praeteritum:</hi> ymbsyrede <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 13; stæl 25; onfengon, lærde, oferhogdon, sealde 49,7; sealde <ref type="lawCode" target="law:Ine">Ine</ref> 53; geonbyrde 76,2; befæston <ref type="lawCode" target="law:IIEw">II Ew</ref> 3; wolde <ref type="lawCode" target="law:IIAs">II As</ref> 26,1; namon VI 1,4; namode 10; forsocan <ref type="lawCode" target="law:IIEm">II Em</ref> 1,2; sceolde <ref type="lawCode" target="law:Hu">Hu</ref> 7,1; abere þæt he aberan scolde <hi rend="italic">was jener hätte sollen</hi> <ref type="lawCode" target="law:IIIEg">III Eg</ref> 6,1; sealde 6,2; moston <ref type="lawCode" target="law:IICn">II Cn</ref> 75 <hi rend="bold">3</hi>) <hi rend="italic">umgekehrt Praeteritum gemeint <ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref> Form des Plusqpf:</hi> wæs (wearð) geworden, <hi rend="italic">geschah</hi> (<hi rend="italic">wurde</hi>), <ref type="lawCode" target="law:ICn">I Cn</ref> Insc <ref type="lawCode" target="law:D">D</ref> (<ref type="lawCode" target="law:Grith">Grið</ref> 22) <hi rend="bold">4</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref> Praesens ausgedrückt <ref type="abbreviation" target="gram:sieheDN"><abbr>s. d. n.</abbr></ref></hi> 2</dictScrap>
