        <dictScrap type="liebermann"><hi rend="bold">ilc</hi> <hi rend="italic">selbig, gleich</hi> <hi rend="bold">I</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:adjektiv"><abbr>adj</abbr></ref>, <ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref>:</hi> þæs ilca Godes <ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 2,2; ~can <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 21 | <hi rend="italic"><ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref>:</hi> þam ylcan geburhscipe, þe <hi rend="italic">demselben, <ref type="abbreviation" target="gram:wo"><abbr>wo</abbr></ref></hi> <ref type="lawCode" target="law:IEw">I Ew</ref> 1,4 | <hi rend="italic"><ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref>:</hi> þone ylcan dom, þe <hi rend="italic">denselben, wie</hi> <ref type="lawCode" target="law:IICn">II Cn</ref> 8,2 ‖ <hi rend="bold"><hi rend="italic">fm</hi></hi> <hi rend="italic"><ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref>:</hi> þære ilcan wisan <ref type="lawCode" target="law:Af">Af</ref> 42,6; yl- <ref type="lawCode" target="law:Ld">Ld</ref> | <hi rend="italic"><ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref>:</hi> on þa ilcan wisan; <ref type="lawCode" target="law:Ine">Ine</ref> 23,2; þa ilca hond <ref type="lawCode" target="law:IudDeiIV">Iud Dei IV</ref> 3,5 ‖ <hi rend="bold"><hi rend="italic">nt:</hi></hi> þæt ilce wite þe <ref type="lawCode" target="law:IIAs">II As</ref> 3 | <hi rend="italic"><ref type="abbreviation" target="gram:Instrumental"><abbr>instr</abbr></ref>:</hi> þy ilcan ryhte <ref type="lawCode" target="law:Ine">Ine</ref> 34,1 <hi rend="bold">II</hi>) <hi rend="italic"><ref type="abbreviation" target="gram:Substantiv"><abbr>subst</abbr></ref>:</hi> se ilca <ref type="lawCode" target="law:Wi">Wi</ref> Pro 1 | <hi rend="italic"><ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref>:</hi> ilcan <ref type="lawCode" target="law:IVAs">IV As</ref> 6,3 ‖ <hi rend="bold"><hi rend="italic">nt</hi></hi> <hi rend="italic"><ref type="abbreviation" target="gram:Genitiv"><abbr>gn</abbr></ref>:</hi> þæs ylcon scyldige, þe <ref type="lawCode" target="law:IIEm">II Em</ref> 2 | <hi rend="italic"><ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref>:</hi> be þam ilcan <hi rend="italic">unter demselben Verhältnis</hi> <ref type="lawCode" target="law:IIAs">II As</ref> 3,2 | <hi rend="italic"><ref type="abbreviation" target="gram:accusativus"><abbr>ac</abbr></ref>:</hi> þæt ilce <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 20 (<hi rend="italic"><ref type="abbreviation" target="gram:Variante"><abbr>Var.</abbr></ref></hi> ylce; sylfe <ref type="lawCode" target="law:G">G</ref>). 49,4 (ylce <ref type="lawCode" target="law:Ld">Ld</ref>). <ref type="lawCode" target="law:Ine">Ine</ref> 75. <ref type="lawCode" target="law:IEw">I Ew</ref> 1,3. <ref type="lawCode" target="law:IAs">I As</ref> Pro; ylce <ref type="lawCode" target="law:IEm">I Em</ref> 4 (hylce <ref type="lawCode" target="law:H">H</ref>); illce <ref type="lawCode" target="law:Hu">Hu</ref> 3,1. — <ref type="lawCode" target="law:Ld">Ld</ref> <hi rend="italic"><ref type="abbreviation" target="gram:setzt"><abbr>setzt</abbr></ref></hi> ylc <hi rend="italic"><ref type="abbreviation" target="gram:fur"><abbr>für</abbr></ref></hi> ælc <hi rend="italic"><ref type="abbreviation" target="gram:jeder"><abbr>jeder</abbr></ref>:</hi> <ref type="lawCode" target="law:VAs">V As</ref> 1,1; 5. <ref type="lawCode" target="law:IIEg">II Eg</ref> 2,2</dictScrap>
