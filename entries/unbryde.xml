        <dictScrap type="liebermann"><hi rend="bold">unbryde</hi>; ic hit hæbbe ~ ⁊ unforboden <hi rend="italic">ich besitze es unangefochten und unverboten</hi> <ref type="lawCode" target="law:Becwaeth">Becwæð</ref> 2; <hi rend="italic"><ref type="abbreviation" target="gram:als"><abbr>als</abbr></ref> <ref type="abbreviation" target="gram:Praeteritum"><abbr>ptt</abbr></ref> <ref type="abbreviation" target="gram:Particip"><abbr>pc</abbr></ref> zu vermuten erstens <ref type="abbreviation" target="gram:aus"><abbr>aus</abbr></ref> Parallelismus</hi> [<hi rend="italic"><ref type="abbreviation" target="gram:sieheOben"><abbr>s. o.</abbr></ref> <ref type="abbreviation" target="gram:Seite"><abbr>S.</abbr></ref></hi> 11 <ref type="abbreviation" target="gram:folgende"><abbr>f.</abbr></ref>] <hi rend="italic"><ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref></hi> unforboden, <hi rend="italic">zweitens <ref type="abbreviation" target="gram:aus"><abbr>aus</abbr></ref> beiden urkundl. Kaufformeln:</hi> gebohte þæt land únbecwedene ⁊ únforbodene [<hi rend="italic"><ref type="abbreviation" target="gram:circa"><abbr>c.</abbr></ref></hi> 961; <hi rend="italic">Birch</hi> Cartul. 1063] <hi rend="italic">und</hi> gebohte 5 hide landes unforboden ⁊ unbesacen [<hi rend="italic"><ref type="abbreviation" target="gram:circa"><abbr>c.</abbr></ref></hi> 1012—40; <hi rend="italic">Thorpe</hi> Diplom. 375]; <hi rend="italic"><ref type="abbreviation" target="gram:vergleiche"><abbr>vgl</abbr></ref>.</hi> brygdan <hi rend="italic">und zum schwachen</hi> [<hi rend="italic"><ref type="abbreviation" target="gram:oder"><abbr>oder</abbr></ref> unorgan.</hi>] -e <hi rend="italic">5 <ref type="abbreviation" target="gram:ZeileVorher"><abbr>Z. vorher</abbr></ref></hi></dictScrap>
