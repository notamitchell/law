        <dictScrap type="liebermann"><hi rend="bold">belimpan</hi> <ref type="lawCode" target="law:Af">Af</ref> 6; belympan <ref type="lawCode" target="law:So">So</ref> <ref type="lawCode" target="law:Ld">Ld</ref> | 3: ~pð <ref type="lawCode" target="law:Ger">Ger</ref> 3; ~pað 3,1; belympað Norðleod 1 <ref type="lawCode" target="law:Ld">Ld</ref> | <hi rend="italic"><ref type="abbreviation" target="gram:Plural"><abbr>pl</abbr></ref></hi> 3: ~að <ref type="lawCode" target="law:Ger">Ger</ref> 3,1 | <hi rend="italic"><ref type="abbreviation" target="gram:Optativ"><abbr>op</abbr></ref></hi> 3: ~pe <ref type="lawCode" target="law:Af">Af</ref> 2. 6,1 (belympe <ref type="lawCode" target="law:So">So</ref> <ref type="lawCode" target="law:Ld">Ld</ref>). 31,1; ~mbe <ref type="lawCode" target="law:B">B</ref> | <hi rend="italic"><ref type="abbreviation" target="gram:Praeteritum"><abbr>ptt</abbr></ref></hi> 3: belampe [! <hi rend="italic">unorg</hi>. e] <ref type="lawCode" target="law:Af">Af</ref> <ref type="lawCode" target="law:El">El</ref> 49,2 <ref type="lawCode" target="law:Ld">Ld</ref>. — <hi rend="bold">1</hi>) ~ to <hi rend="italic">gehören zu</hi> <ref type="lawCode" target="law:Ger">Ger</ref> 3. 3,1; ham, þe feorm to belimpð <hi rend="italic"><ref type="abbreviation" target="gram:auf"><abbr>auf</abbr></ref> welchem</hi> <hi rend="italic">Gastung lastet</hi> <ref type="lawCode" target="law:Af">Af</ref> 2; <hi rend="italic">zustehen, gebühren</hi> (to <hi rend="italic">jem</hi>.) se wære belympað to þam mægðe Norðleod 1 <ref type="lawCode" target="law:Ld">Ld</ref>; gebirað magum <hi rend="italic">älter</hi> <hi rend="bold">2</hi>) [<hi rend="italic"><ref type="abbreviation" target="gram:unpersonlich"><abbr>unpersönlich</abbr></ref></hi>] <hi rend="italic">sich gehören, passen</hi> (to <hi rend="italic">zu</hi>) <ref type="lawCode" target="law:Af">Af</ref> 6. 6,1. 31,1 (<hi rend="italic"><ref type="abbreviation" target="gram:auchOhne"><abbr>auch ohne</abbr></ref></hi> hit) | <hi rend="italic"><ref type="abbreviation" target="gram:mit"><abbr>mit</abbr></ref> <ref type="abbreviation" target="gram:Dativ"><abbr>dt</abbr></ref></hi>: <hi rend="italic">es glückt mir</hi> AI <ref type="lawCode" target="law:El">El</ref> 49,2 <ref type="lawCode" target="law:Ld">Ld</ref>; spowan <hi rend="italic">älter</hi>. — <hi rend="italic"><ref type="abbreviation" target="gram:ersetzt"><abbr>Ersetzt</abbr></ref></hi> <hi rend="italic"><ref type="abbreviation" target="gram:durch"><abbr>durch</abbr></ref></hi> gelimpan, tobelimpan <hi rend="italic"><ref type="abbreviation" target="gram:siehe"><abbr>s.</abbr></ref></hi> <hi rend="italic">d</hi>. — <hi rend="italic">Der</hi>.: tob~</dictScrap>
