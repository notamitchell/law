    <body>
      <div type="clause" n="Epilog.">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> Epilog.</head>
        <ab type="selectedText" xml:lang="und">Sit nomen Domini benedictum ex hoc nunc et usque in seculum!</ab>
        <ab type="translation" xml:lang="en">Blessed be the name of the Lord from now and into eternity.</ab>
        <ab type="secondTranslation" xml:lang="en">Blessed be the name of the Lord, from henceforth and forever.</ab>
