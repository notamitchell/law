  <text>
    <body>
      <div type="clause" n="67.1">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 67.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="67.1" corresp="#wit-h">Gyfe ofer ynce scilling,</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="67.1" corresp="#wit-h">Gyfe ofer ynce, scilling.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">If [the width of the wound] is over an inch, a shilling;</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">For a stab over an inch [deep], 1 shilling;</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn [der Stich] über 1 Zoll [lang ist, 1] Schilling,</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If [the stab is] over 1 inch [long, 1] shilling,</ab>
      </div>
    </body>
