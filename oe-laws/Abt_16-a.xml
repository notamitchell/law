      <div type="clause" n="16[a]">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 16[a]</head>
        <ab type="selectedText" xml:lang="und">Gif wið eorles birele man geligeþ, VI scillingum gebete.</ab>
        <ab type="translation" xml:lang="en">If a person lies with a freeman’s cupbearer, let him pay with 6 shillings.</ab>
