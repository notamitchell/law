    <body>
      <div type="clause" n="16[a]">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 16[a]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="16[a]" corresp="#wit-h">Gif wið ceorles birelan man geligeþ, VI scillingu<hi rend="italic">m</hi> gebete;</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="21" corresp="#wit-h">Gif wið ceorles birele man geligeþ, VI scillingu<hi rend="italic">m</hi> gebete.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">If a person lies with a freeman’s cupbearer, let him pay with 6 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">If a man lies with a commoner’s serving maid, he shall pay 6 shillings compensation;</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">If anyone lie with a ceorl’s serving-woman, he is to pay six shillings compensation; [if] with a slave-woman of the second [class], 50 sceattas; [if with one of] the third [class], 30 sceattas.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn bei eines Gemeinfreien Schenkin<ptr type="liebermannNote" n="1" target="#Abt_16-a.lnote.de.1"/> jemand liegt, büsse er [ihm] mit 6 Schillingen<ptr type="liebermannNote" n="2" target="#Abt_16-a.lnote.de.2"/>,</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone lies with a common freeman’s cup-bearer [woman], let him pay [him] 6 shillings;</ab>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_10">Af 10–11.5</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_18-1">Af 18.1–18.3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_25">Af 25–25.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="281"><ref target="clause:Af_26">Af 26</ref></note>
        <note type="translator" source="#whitelock">probably a weight of gold, the twentieth part of a shilling; see p. 52.</note>
        <note type="translator" source="#whitelock">Whitelock translates Abt 16 as one clause, which the sheet divides into rows 16[a], 16[b], 16[c]; her translation of the whole is given here, in the first row.</note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_16-a.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">7</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">S. o.</hi> 14¹</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">See above</hi> 14¹</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_16-a.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">7</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">‘Schutz’ des Herrn wie <hi rend="italic">o.</hi> 13³</seg><seg type="translation" xml:lang="en" source="#claude">‘Protection’ of the lord as <hi rend="italic">above</hi> 13³</seg></note>
      </div>
    </body>
