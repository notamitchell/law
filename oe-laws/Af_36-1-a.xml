    <body>
      <div type="clause" n="36.1[a]">
        <head><ref type="lawCode" target="law:Af">Af</ref> 36.1[a]</head>
        <ab type="selectedText" xml:lang="und">Gif beforan eagum asnase, gielde þone wer.</ab>
        <ab type="translation" xml:lang="en">If he should impale himself before the eyes [of the spear-carrier], let him pay the wer.</ab>
        <ab type="secondTranslation" xml:lang="en">If a man is transfixed before his eyes, he shall pay the wergeld;</ab>
        <ab type="supplementaryText" xml:lang="und">Gif beforan eagum asnæse, gilde þone wer.</ab>
      </div>
