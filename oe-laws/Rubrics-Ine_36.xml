      <div type="clause" n="36">
        <head>Ine Rb 36</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36" corresp="#wit-e"><pb n="22" ed="#liebermann"/>LXXX. Be<ptr type="liebermannNote" n="**" target="#Rubrics-Ine_36.lnote.oe.star2"/> ðeofes onfenge, ⁊ hine ðonne forlæte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36" corresp="#wit-g-prol"><pb n="22" ed="#liebermann"/>LXXX. Be ðeofes onfenge, ⁊ hine þænne forlæte.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36" corresp="#wit-h"><pb n="23" ed="#liebermann"/>LXXX. Be ðeofes onfenge, ⁊ hine mon<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_36.lnote.oe.2"/> ðonne forlæte.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="36" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De fure<ptr type="liebermannNote" n="26" target="#Rubrics-Ine_36.lnote.oe.26"/> capto et dimisso.<ptr type="liebermannNote" n="27" target="#Rubrics-Ine_36.lnote.oe.27"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="206" ed="#jurasinski-and-oliver"/>LXXX Be ðeofes onfenge, hine ðonne forlæte</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="206" ed="#jurasinski-and-oliver"/>Be ðeofes andfenge hine swa forlæte</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="23" ed="#liebermann"/>Vom Einfangen eines Diebes, und [wenn man<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_36.lnote.de.1"/>] ihn nachher ent[wischen] lässt.<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_36.lnote.de.2"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Of the catching of a thief, and [someone] afterwards letting him [escape].</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning the capture of a thief, and then letting him go</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="207" ed="#jurasinski-and-oliver"/>Concerning the capture of a thief, and thus letting him go</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_36.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">22</biblScope></bibl><seg type="original" xml:lang="de">Be ðon ðe mon þeof forl. <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">Be ðon ðe mon þeof forl. Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_36.lnote.oe.26" n="26" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">c. et d. f. <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. et d. f. T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_36.lnote.oe.27" n="27" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">vel furto celato <hi rend="italic">fügt zu Hk Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">vel furto celato added by Hk Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_36.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">23</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_36.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">mon</hi> ist spätere Stilerleichterung; <hi rend="italic">s. o.</hi> Rb 9¹</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">mon</hi> is a later stylistic simplification; <hi rend="italic">see above</hi> Rb 9¹</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_36.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollstänigt die Rb</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb</seg></note>
      </div>
