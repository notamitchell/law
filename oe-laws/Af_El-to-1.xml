    <body>
      <div type="clause" n="El. 1">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 1" corresp="#wit-h">Ne lufa þu oðre fremde godas ofer me.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 1" corresp="#wit-e">Ne lufa þu oþre fremde godas ofer me.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 1" corresp="#wit-g-prol-only">Ne lufa ðu oðre fremde godas ofer mé.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 1" corresp="#wit-q">Non habebis deos alienos coram me.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 1" corresp="#wit-e">Ne lufa ðu oþre fremde godas ofer me.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">You will not love other strange gods in place of me.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Nicht liebe du andere fremde Götter ausser mir.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Do not love other foreign gods besides me.</ab>
        <note type="passageSource">Exodus 20,3</note>
      </div>
    </body>
