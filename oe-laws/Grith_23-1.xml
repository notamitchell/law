    <body>
      <div type="clause" n="23.1">
        <head><ref type="lawCode" target="law:Grith">Grið</ref> 23.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="23.1" corresp="#wit-g-b">Swylc understandað þa ðe Godes ege habbað 7 wisdomes gymað.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" n="23.1" corresp="#wit-g-b">Swylc understandað þa ðe Godes ege habbað and wisdomes gymað.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Solches begreifen die, welche Gottesfurcht haben und auf Weisheit achten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Those understand such things who have the fear of God and heed wisdom.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-b">This is understood by those who have a fear of God and heed wisdom.</ab>
        <note type="comparison" source="#liebermann" n="472"><ref target="clause:Grith_21-1">Grið 21.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">s. o. 21, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Grith_21-1">Grið 21.1</ref></note>
        <note type="translator" source="#rabin-doml">fear of God and heed wisdom: See Proverbs 1:7.</note>
      </div>
    </body>
