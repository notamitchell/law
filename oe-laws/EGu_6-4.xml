    <body>
      <div type="clause" n="6.4">
        <head><ref type="lawCode" target="law:EGu">EGu</ref> 6.4</head>
        <ab type="selectedText" xml:lang="und">Gif hwá ænigra godcundra gerihto forwyrne, gylde lahslit mid Denum, wíte mid Englum.</ab>
        <ab type="translation" xml:lang="en">If anyone refuses [to render] any church dues, he shall pay lahslit in a Danish district, and a fine in an English district.</ab>
        <ab type="supplementaryText" xml:lang="und">Gyf hwá ænigra godcundra gerihta forwyrna, gylde lahslitt mid Denum, wite mid Englum.</ab>
      </div>
