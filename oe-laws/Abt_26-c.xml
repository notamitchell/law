    <body>
      <div type="clause" n="26[c]">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 26[c]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="26[c]" corresp="#wit-h">ðane þriddan, XL scillinḡ forgelden.<ptr type="liebermannNote" n="*" target="#Abt_26-c.lnote.oe.star"/></ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="27.2" corresp="#wit-h">Ðane þriddan, XL scilling<hi rend="italic">um</hi> forgelde(n).</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">[For one of] that third [rank], let him pay with 40 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">[for slaying one of] the third class, he shall pay 40 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">if one of the third class, he is to pay 40 shillings.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">den dritten entgelte er mit 40 Schilling.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">the third let him pay for with 40 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_26-c.lnote.oe.star" n="*" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">4</biblScope></bibl><seg type="original" xml:lang="de">forgelde <hi rend="italic">emendiren Edd.</hi></seg><seg type="translation" xml:lang="en" source="#claude">editors emend to forgelde</seg></note>
      </div>
    </body>
  </text>
