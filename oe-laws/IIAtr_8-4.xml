      <div type="clause" n="8.4">
        <head><ref type="lawCode" target="law:IIAtr">II Atr</ref> 8.4</head>
        <ab type="selectedText" xml:lang="und">⁊ tyme hit mon æure ðær hit ærost befangen beo.</ab>
        <ab type="translation" xml:lang="en">And vouching to warranty shall always take place where the property has first been attached.</ab>
        <ab type="supplementaryText" xml:lang="und">Et ueniat, ubi primitus fuit interciatum.</ab>
