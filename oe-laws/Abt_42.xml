  <text>
    <body>
      <div type="clause" n="42">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 42</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="42" corresp="#wit-h">Gif eare<ptr type="liebermannNote" n="5" target="#Abt_42.lnote.oe.5"/> sceard weorðeþ, VI scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="41" corresp="#wit-h">Gif eare sceard weorðeþ, VI sciƚƚ gebete.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">If an ear becomes gashed, let him pay [with] 6 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">If an ear is lacerated, 6 shillings shall be paid as compensation.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn ein Ohr<ptr type="liebermannNote" n="1" target="#Abt_42.lnote.de.1"/> schartig<ptr type="liebermannNote" n="2" target="#Abt_42.lnote.de.2"/> wird, büsse er 6 Schill.<ptr type="liebermannNote" n="3" target="#Abt_42.lnote.de.3"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If an ear is notched, let him pay 6 shillings.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Abt_42.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">5</biblScope></bibl><seg type="original" xml:lang="de">earesceard <hi rend="italic">könnte auch</hi> <hi rend="spaced">ein</hi> <hi rend="italic">Wort sein</hi></seg><seg type="translation" xml:lang="en" source="#claude">earesceard could also be one word</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_42.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">11</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die Bildung <hi rend="italic">earesceard</hi> entspräche zwar ahd. <hi rend="italic">orscarti</hi> ‘Ohrenscharte, Zerhackung des Ohres’. Doch fällt das Endungs-<hi rend="italic">e</hi> in fast (<hi rend="italic">s.</hi> jedoch Toller <hi rend="italic">Suppl.</hi> 170 letzte Z.) allen Kompositis fort; auch steht <hi rend="italic">sceard</hi> als Adjektiv in 48</seg><seg type="translation" xml:lang="en" source="#claude">The formation <hi rend="italic">earesceard</hi> would indeed correspond to OHG <hi rend="italic">orscarti</hi> ‘ear-notch, hacking of the ear’. But the ending-<hi rend="italic">e</hi> drops out in almost (<hi rend="italic">see</hi>, however, Toller <hi rend="italic">Suppl.</hi> 170 last l.) all compounds; also <hi rend="italic">sceard</hi> stands as an adjective in 48</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_42.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">11</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Technisch auch in <hi rend="italic">Lex Baiuw.</hi> I 4, 14, <hi rend="italic">Alam.</hi> 57, 10 und bei Friesen; His 279</seg><seg type="translation" xml:lang="en" source="#claude">Technical also in <hi rend="italic">Lex Baiuw.</hi> I 4, 14, <hi rend="italic">Alam.</hi> 57, 10 and among the Frisians; His 279</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_42.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">11</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Dieselbe Schillingsumme bei Baiern und Alamannen</seg><seg type="translation" xml:lang="en" source="#claude">The same sum of shillings among the Bavarians and Alamanni</seg></note>
      </div>
    </body>
