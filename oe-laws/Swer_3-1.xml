  <text>
    <body>
      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:Swer">Swer</ref> 3.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-b"><pb n="396" ed="#liebermann"/>Ac swa ic orf hæbbe, swa ic hit mid rihte begeat.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="3.1" corresp="#wit-q"><pb n="397" ed="#liebermann"/>Sed sic pecus habeo, sicut recte adquisiui.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="3.1" corresp="#wit-h"><pb n="396" ed="#liebermann"/>Ac swa ic orf hæbbe, swa ic hit mid rihte begeat.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="397" ed="#liebermann"/>Sondern só hab ich Vieh, wie ich es rechtlich erworben habe.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">But I have the cattle just as I lawfully acquired it.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-h">However, I [do] have cattle that I acquired legally.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Duns_8-2">Duns 8.2</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="385"><ref target="clause:Becwaeth_1">Becwæð 1</ref></note>
      </div>
