  <text>
    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-d">Gif pr<hi rend="italic">eost</hi> do<hi rend="italic">m</hi> to læwedu<hi rend="italic">m</hi> sceote, þe he to gehadedu<hi rend="italic">m</hi> scolde, gilde XX ór.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d">If a priest refers a case to a layman which he ought to refer to an ecclesiastic, he is to pay 20 ores.</ab>
        <ab type="translation" xml:lang="en" source="#rabin" corresp="#wit-d">If a priest turns judgment in a dispute over to a layman which he should refer to an ecclesiastic, he is to pay twenty ores.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn ein Priester ein Processurtheil, das er bei Geistlichen [nachsuchen] sollte, an Laien überträgt, zahle er 20 Ör.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a priest refers to laymen a judgment which he should [seek] from clergy, let him pay 20 ores.</ab>
        <note type="editorial">Liebermann compares the Canons of Edgar.</note>
      </div>
    </body>
  </text>
