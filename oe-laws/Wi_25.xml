  <text>
    <body>
      <div type="clause" n="25">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 25</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="25" corresp="#wit-h">Gif man leud ofslea an þeofðe, licge buton wyrgelde.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="20" corresp="#wit-h">Gif man leud ofslea an þeofðe, licge buton wyrgelde.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">If a person kills a man in the act of theft, let him lie without <hi rend="italic">wergild</hi>.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">If anyone slays a man in the act of thieving, no wergeld shall be paid for him.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">If anyone kill a man who is in the act of thieving, he is to lie without wergild.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn man einen Menschen bei [dessen] Diebstahl erschlägt, so liege dieser [todt], ohne Wergeld.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone slays a man in the act of [his] theft, let the latter lie [dead] without wergeld.</ab>
      </div>
    </body>
