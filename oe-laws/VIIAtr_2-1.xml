    <body>
      <div type="clause" n="2.1">
        <head><ref type="lawCode" target="law:VIIAtr">VII Atr</ref> 2.1</head>
        <ab type="selectedText" xml:lang="und">Et omnis homo ad confessionem vadat et nudis pedibus ad ecclesiam et peccatis omnibus abrenuntiet emendando, cessando.</ab>
        <ab type="translation" xml:lang="en">And everyone shall go to confession and with bare feet to church, and by making amends and ceasing [from evil] shall renounce all [his] sins.</ab>
