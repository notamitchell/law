  <text>
    <body>
      <div type="clause" n="46">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 46</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="46" corresp="#wit-d-incomplete">⁊ þ<hi rend="italic">æt</hi> hi Godes þearfan frefrian ⁊ fedan.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="46" corresp="#wit-k">⁊ þæt hy Godes þearfan frefrian ⁊ fedan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k">And þæt hy Godes þearfan frefrian and fedan.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k">And that they should comfort and feed the poor of God.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k">And that God’s poor are to be comforted and fed.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Und dass sie Gottes Arme trösten und ernähren.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And that they comfort and feed God's poor.</ab>
      </div>
    </body>
