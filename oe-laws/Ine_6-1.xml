    <body>
      <div type="clause" n="6.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 6.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.1" corresp="#wit-h">Gif hwa on mynstre gefeohte, CXX scll' gebete.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6.1" corresp="#wit-e">Gif hwa on mynster gefeohte, CXX scill. gebete.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.1" corresp="#wit-q">Si quis in ecclesia pugnet, centum uiginti sol. emendet.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="6.1" corresp="#wit-e">Gif hwa on mynstre gefeohte, CXX sciƚƚ gebete.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">If someone fights in the minster, let him pay 120 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e">If anyone fights in a monastery, he shall pay 120 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock">If anyone fights in a minster, he is to pay 120 shillings compensation.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn jemand in einem Kloster ficht, büsse er [diesem] 120 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone fights in a minster, let him pay [it] 120 shillings.</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Grith_10">Grið 10</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="280"><ref target="clause:Af_2">Af 2–2.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="280"><ref target="clause:Af_5">Af 5–5.4</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="280"><ref target="clause:Af_6">Af 6–6.1</ref></note>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="311"><ref target="clause:Af_15">Af 15</ref></note>
      </div>
