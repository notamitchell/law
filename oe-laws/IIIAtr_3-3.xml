    <body>
      <div type="clause" n="3.3">
        <head><ref type="lawCode" target="law:IIIAtr">III Atr</ref> 3.3</head>
        <ab type="selectedText" xml:lang="und">⁊ ælc bicge him lage mid XII óran, healf landrican, healf wæpentake.</ab>
        <ab type="translation" xml:lang="en">And each of them shall pay 12 ores, half to the lord of the manor and half to the wapentake, in order to obtain the benefit of the law.</ab>
        <ab type="supplementaryText" xml:lang="und">Et omnis emat sibi lagam duodecim oris, dimidium landesrico, dimidium wapentako.</ab>
      </div>
