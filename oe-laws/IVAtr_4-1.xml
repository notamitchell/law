  <text>
    <body>
      <div type="clause" n="4.1">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 4.1</head>
        <ab type="selectedText" xml:lang="und">Si pugnet antequam sibi rectum postulet ac vivat, emendet regis burhbrece quinque libris.</ab>
        <ab type="translation" xml:lang="en">If, before demanding justice, he has recourse to violence, but does not lose his life thereby, he shall pay 5 pounds for breach of the king's peace.</ab>
      </div>
