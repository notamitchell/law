      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:IIIEm">III Em</ref> 7.1</head>
        <ab type="selectedText" xml:lang="und">Et omnes infamati et accusationibus ingravati sub plegio redigantur.</ab>
        <ab type="translation" xml:lang="en">And all men of ill-repute and those who have been frequently accused shall be placed under surety.</ab>
