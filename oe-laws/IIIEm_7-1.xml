  <text>
    <body>
      <div type="clause" n="7.1">
        <head><ref type="lawCode" target="law:IIIEm">III Em</ref> 7.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="7.1" corresp="#wit-q">Et omnes infamati et accusationibus ingrauati sub plegio redigantur.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="7.1" corresp="#wit-q">Et omnes infamati et accusationibus ingravati sub plegio redigantur.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q">And all men of ill-repute and those who have been frequently accused shall be placed under surety.</ab>
        <note type="editorial">Latin only; no German translation in Liebermann. Liebermann compares II As 20, 1.4.</note>
      </div>
