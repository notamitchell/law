    <body>
      <div type="clause" n="32">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 32</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32" corresp="#wit-h">Gif man rihthamscyld þurhstinð, mid weorðe forgelde.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="32" corresp="#wit-h">Gif man rihthamscyld þurh stinð, mid weorðe forgelde.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">If a person pierces through the <hi rend="italic">rihthamscyld</hi>, let him pay with [its] worth.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">If anyone damages the enclosure of a dwelling, he shall pay according to its value.</ab>
      </div>
