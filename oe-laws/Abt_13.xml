  <text>
    <body>
      <div type="clause" n="13">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 13</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="13" corresp="#wit-h">Gif on eorles tune man mannan ofslæhþ, XII scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="18" corresp="#wit-h">Gif on eorles tune man mannan ofslæhþ, XII scilƚ gebete.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">If a person kills someone in a nobleman’s dwelling, let him pay 12 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">If one man slays another on the premises of a nobleman, he shall pay 12 shillings compensation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">If anyone kills a man in a nobleman’s estate, he is to pay 12 shillings compensation.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn jemand in eines Adligen Hofbezirk einen Menschen erschlägt, büsse er [jenem] 12 Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone slays a person in a nobleman’s court-precinct, let him pay [the latter] 12 shillings.</ab>
      </div>
    </body>
