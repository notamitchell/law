  <text>
    <body>
      <div type="clause" n="5.1[b]">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 5.1[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1[b]" corresp="#wit-h">⁊ gehwæder þ<hi rend="italic">æt</hi> hæmed mid hreowe forlæte.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="4.2" corresp="#wit-h">⁊ gehwæder þ<hi rend="italic">æt</hi> hæmed mid hreowe forlæte.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">And let each of them relinquish the union with repentance.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">and [in] either [case the offender] shall desist from the union, with repentance.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Und jeder von beiden verlasse jenes Verhältniss unter Bereuung.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let each of the two give up that relationship with repentance.</ab>
      </div>
    </body>
