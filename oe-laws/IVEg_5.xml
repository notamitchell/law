  <text>
    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:IVEg">IV Eg</ref> 5</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-f">to smalum burgum ⁊ to ælcum hundrode XII, buton ge má willan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5" corresp="#wit-c">to smalum burgum ⁊ to ælcum hundrode XII, buton ge má wyllan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5" corresp="#wit-q">in ciuitatulis uero duodecim eligantur.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="5" corresp="#wit-c">To smalum burgum ⁊ to ælcum hundrode XII, buton ge má wyllan.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">zu kleinen Städten und zu jeder Hundertschaft 12, ausser wenn ihr mehr wollt.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">for small boroughs and for every hundred 12, unless you want more.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-c">12 [shall be chosen] for small boroughs and for every hundred, unless you desire more.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock">twelve for small boroughs and for each hundred, unless you wish for more.</ab>
        <note type="comparedBy" source="#wormald-mel" n="381"><ref target="clause:Duns_3-2">Duns 3.2–3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="370"><ref target="clause:Forf_1">Forf 1</ref></note>
      </div>
    </body>
