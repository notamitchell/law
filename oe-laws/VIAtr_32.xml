  <text>
    <body>
      <div type="clause" n="32">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 32</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32" corresp="#wit-d-incomplete">swa ymbe fryðes bote, swa beo þa<hi rend="italic">m</hi> bóndan selost ⁊ þa<hi rend="italic">m</hi> þeofan sy laðost,</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="32" corresp="#wit-k">Swa ymbe friþes bote swa þam bondan sy selost ⁊ þam þeofan sy laþost;</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k">Public security shall be promoted in such a way as shall be best for the householder and worst for the thief.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">so auf die Sicherheitsrechtsform, wie dem Hausvater (bäuerlichen Wirthe) am liebsten und den Dieben am leidesten sei,</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">on public security, in the way that is best for the householder (the farmer) and most hateful to thieves,</ab>
      </div>
    </body>
  </text>
