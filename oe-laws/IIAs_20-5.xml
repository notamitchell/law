    <body>
      <div type="clause" n="20.5">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 20.5</head>
        <ab type="selectedText" xml:lang="und">Gif he nite, hwa hine aborgie, hæfton hine.</ab>
        <ab type="translation" xml:lang="en">And if he knows no one who will act as surety for him, they shall arrest him.</ab>
        <ab type="supplementaryText" xml:lang="und">Gif he nyt, hwa hine aborgige, hæften hine.</ab>
      </div>
