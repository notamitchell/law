    <body>
      <div type="clause" n="2.3a">
        <head><ref type="lawCode" target="law:VIIAtr">VII Atr</ref> 2.3a</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.3a" corresp="#wit-q">Hii sunt illi tres dies: dies Lune, dies Martis et dies Mercurii proximi ante festum sancti Michaelis.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="2.3a" corresp="#wit-q">Hii sunt illi tres dies—dies Lunae, dies Martis et dies Mercurii proximi ante festum sancti Michaelis.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q">These are the three days—the Monday, Tuesday and Wednesday immediately preceding the feast of St Michael.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Dies sind jene drei Tage: Montag, Dienstag und Mittwoch zunächst vor dem Michaelisfeste [29. September].</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">These are the three days: the Monday, Tuesday and Wednesday next before Michaelmas [29 September].</ab>
        <note type="comparison" source="#liebermann" n="260"><ref target="clause:VIIaAtr_1">VIIa Atr 1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 1</note>
