    <body>
      <div type="clause" n="36.2[a]">
        <head><ref type="lawCode" target="law:Af">Af</ref> 36.2[a]</head>
        <ab type="selectedText" xml:lang="und">gif se ord sie ufor þonne hindeweard sceaft.</ab>
        <ab type="translation" xml:lang="en">if the point is higher than the shaft in the back.</ab>
        <ab type="secondTranslation" xml:lang="en">supposing the point to be higher than the [other] end of the shaft, by the width of three fingers.</ab>
        <ab type="supplementaryText" xml:lang="und">gif se ord sy þreo fingre ufor þonne hindeweard sceaft.</ab>
      </div>
