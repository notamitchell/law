    <body>
      <div type="clause" n="59[a]">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 59[a]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="59[a]" corresp="#wit-h">CIII. Cúhorn bið V peninga weorð;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="59[a]" corresp="#wit-e">CIII. Cuuhorn bið twegea pæninga;</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="59[a]" corresp="#wit-q">uacce II den.;</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="62.1" corresp="#wit-e">{CIII} Cuuhorn \bið/ twegea pæninga;</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">A cow horn is worth 2 pennies.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e">A cow's horn is worth 2 pence:</ab>
        <ab type="translation" xml:lang="en" source="#whitelock">The horn of a cow [is valued at] twopence; the tail of an ox is valued at a shilling; that of a cow at fivepence; the eye of an ox is valued at fivepence, that of a cow at a shilling.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Ein Kuhhorn gilt 2 Pfennige;</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">A cow’s horn is worth 2 pence;</ab>
        <note type="translator" source="#whitelock">Whitelock translates Ine 59 as one clause, which the sheet divides into rows 59[a], 59[b], 59[c]; her translation of the whole is given here, in the first row.</note>
      </div>
    </body>
