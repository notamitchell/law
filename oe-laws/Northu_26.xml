  <text>
    <body>
      <div type="clause" n="26">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 26</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="26" corresp="#wit-d">Gif pr<hi rend="italic">eost</hi> on circan ungedafenlice þingc gelogige, gebete þ<hi rend="italic">æt</hi>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d">Gif preost on circan ungedafenlice þingc gelogige, gebete þæt.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d">If a priest puts unsuitable things in the church, he is to compensate for it.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d">If a priest puts inappropriate things in a church, he is to atone for that.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn ein Priester in [seine] Kirche unziemliche Dinge niederlegt, büsse er das.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a priest stores unseemly things in [his] church, let him atone for it.</ab>
        <note type="comparison" source="#liebermann" n="381">Can. Eg. 27</note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 27</note>
        <note type="editorial">Liebermann compares Canons of Edgar 27.</note>
      </div>
    </body>
