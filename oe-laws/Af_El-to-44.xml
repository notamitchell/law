      <div type="clause" n="El. 44">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 44" corresp="#wit-h">Onscuna ða leasunga.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 44" corresp="#wit-e">Ónscuna ðu á leasunga.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 44" corresp="#wit-q">Mendacium fugies.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 44" corresp="#wit-e">Ónscuna ðu á leasunga.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">Always shun lies.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Verabscheue du stets Lügen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Always abhor lies.</ab>
        <note type="passageSource">Exodus 23,7</note>
        <note type="comparison" source="#liebermann" n="41">Exodus 23.7</note>
        <note type="comparisonPrinted" source="#liebermann">[23, 7]</note>
