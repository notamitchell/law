    <body>
      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:Hu">Hu</ref> 5.1</head>
        <ab type="selectedText" xml:lang="und">Gyf he hit forsitte, gesylle ðam cynge ðrittig scill'.</ab>
        <ab type="translation" xml:lang="en">If he neglects to do so, he shall pay 30 shillings to the king.</ab>
        <ab type="supplementaryText" xml:lang="und">Si hec supersederint, emendent (hoc pretermittat, emendet) regi XXX sol.</ab>
      </div>
