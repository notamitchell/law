  <text>
    <body>
      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:Hu">Hu</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1" corresp="#wit-q">Si hec supersederint, emendent (hoc pretermittat, emendet) regi XXX sol.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="5.1" corresp="#wit-b">Gyf he hit forsitte, gesylle ðam cynge ðrittig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1" corresp="#wit-cons-cn">Quod si recuset, det regi XXX solidos.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="5.1" corresp="#wit-b">Gyf he hit forsitte, gesylle ðam cynge ðrittig scill'.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b">If he neglects to do so, he shall pay 30 shillings to the king.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn er es versäumt, zahle er dem König 30 Schilling.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If he neglects it, let him pay the king 30 shillings.</ab>
      </div>
    </body>
  </text>
