  <text>
    <body>
      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 5.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="5.1">[Not in D]</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="5.1" corresp="#wit-k">Fulgeorne hi witan þæt hy nagon mid rihte þurh ænig hæmedþing wifes gemanan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k">Fulgeorne hi witan þæt hy nagon mid rihte þurh ænig hæmedþing wifes gemanan.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k">They know full well that they have no right to marry.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k">They know full well that they may not rightfully engage in sexual relations with a woman.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Recht genau wissen sie, dass sie von Rechtswegen keine Gemeinschaft mit einer Frau durch Beischlaf haben dürfen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">They know full well that they may not lawfully have intercourse with a woman.</ab>
      </div>
    </body>
