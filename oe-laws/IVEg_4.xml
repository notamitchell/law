  <text>
    <body>
      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:IVEg">IV Eg</ref> 4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4" corresp="#wit-f">To ælcere byrig XXXVI syn gecorone to gewitnesse;</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="4" corresp="#wit-c">To ælcere byrig XXXIII syn gecorene to gewytnesse;</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="4" corresp="#wit-q">Et ad hoc procurandum et tutandum uiri triginta sex legitimi,</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="4" corresp="#wit-c">To ælcere byrig XXXVI syn gecorene to gewytnesse.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-c">36 persons shall be chosen as witnesses for every borough.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock">Thirty-six are to be chosen as witness for each borough;</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">zu jeder Stadt seien 36 als Zeugenschaft erkoren,</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">for every borough let 36 be chosen as witnesses,</ab>
        <note type="editorial">C's ‘XXXIII’ is a misreading of ‘XXXVI’ (the u = V looks similar in F too).</note>
      </div>
    </body>
