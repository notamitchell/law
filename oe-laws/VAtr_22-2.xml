    <body>
      <div type="clause" n="22.2">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 22.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-g">⁊ word ⁊ weorc fadige mid rihte ⁊ að ⁊ wedd wærlice healde.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22.2" corresp="#wit-g2">⁊ word ⁊ weorc fadige mid rihte ⁊ að ⁊ wedd wærlice healde.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="22.2" corresp="#wit-d">⁊ word ⁊ weorc fadige mid rihte ⁊ að ⁊ wed wærlice healde.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d">And he shall order his words and deeds aright and carefully abide by his oath and his pledge.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g">and to order words and deeds rightly, and keep carefully oath and pledge.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">und ordne [sein] Wort und Werk gerecht und halte sorgsam Eid und Versprechen.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and order [his] words and deeds rightly, and keep oath and pledge carefully.</ab>
        <note type="editorial">Liebermann compares Af 1.</note>
      </div>
    </body>
