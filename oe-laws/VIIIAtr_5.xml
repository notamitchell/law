    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:VIIIAtr">VIII Atr</ref> 5</head>
        <ab type="selectedText" xml:lang="und">Ne syn ealle cyrcan na gelicre mæðe worldlice wirðe, þeah hi goscundlice habban halgunge gelice.</ab>
        <ab type="translation" xml:lang="en">Not all churches are to be regarded as possessing the same status in civil law, though from the side of religion they all possess the same sanctity.</ab>
        <ab type="supplementaryText" xml:lang="und">Ne syn ealle cyrican ná gelicre mæðe woroldlice wyrðe, þe hi godcundlice habban halgunge gelice.</ab>
      </div>
    </body>
