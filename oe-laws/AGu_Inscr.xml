    <body>
      <div type="clause" n="Inscr.">
        <head><ref type="lawCode" target="law:AGu">AGu</ref> Inscr.</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="A Gu Inscr." corresp="#wit-b2">Ælfredes<ptr type="liebermannNote" n="1" target="#AGu_Inscr.lnote.oe.1"/> laga cyninges.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough">[Ælfredes laga cyninges.]<ptr type="editorNote" n="1" target="#AGu_Inscr.attnote.fn.1"/></ab>
        <ab type="translation" xml:lang="de" source="#liebermann">(König Aelfreds<ptr type="liebermannNote" n="1" target="#AGu_Inscr.lnote.de.1"/> Recht <hi rend="italic">B2</hi>.<ptr type="liebermannNote" n="2" target="#AGu_Inscr.lnote.de.2"/>)</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(King Alfred’s law B2.)</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">[The Laws of King Alfred.]</ab>
        <note type="editorial">Heading in B2 only (in red).; T: added from Attenborough p. 98, October 2026 (MS ?); U: added from Attenborough p. 99, October 2026 (MS ?)</note>
        <note type="liebermannNote" subtype="textual" xml:id="AGu_Inscr.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">126</biblScope></bibl><seg type="original" xml:lang="de">Æ. l. c. <hi rend="italic">roth</hi></seg><seg type="translation" xml:lang="en" source="#claude">Æ. l. c. in red</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="AGu_Inscr.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">84</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die Überschrift fehlt in B, und ist unecht in B2; Q nahm die seine wahrscheinlich aus dem Prolog, änderte sie aber in den verschiedenen Rezensionen</seg><seg type="translation" xml:lang="en" source="#claude">The heading is lacking in B and is spurious in B2; Q probably took his from the prologue, but altered it in the various recensions</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="AGu_Inscr.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">84</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">laga</hi>, sg. oder pl., ist Nordisches Lehnwort, also frühestens ein Menschenalter nách Ælfred eingeführt</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">laga</hi>, sg. or pl., is a Norse loan-word, and was therefore introduced a generation after Ælfred at the earliest</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="AGu_Inscr.attnote.fn.1" n="1" source="#attenborough"><bibl><biblScope unit="page">98</biblScope></bibl><label>cyninges</label><seg type="original" xml:lang="en">B 2.</seg></note>
      </div>
    </body>
