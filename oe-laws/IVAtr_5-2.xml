  <text>
    <body>
      <div type="clause" n="5.2">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 5.2</head>
        <ab type="selectedText" xml:lang="und">Et si aliquis eorum accusetur, sit Anglicus sit transmarinus, ladiet se pleno ordalio.</ab>
        <ab type="translation" xml:lang="en">And if one of them is accused, whether he be an Englishman or a foreigner, he shall clear himself by the full ordeal.</ab>
      </div>
