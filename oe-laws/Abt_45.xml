      <div type="clause" n="45">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 45</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="45" corresp="#wit-h">Gif nasu ðyrel weorð, VIIII scillingum gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="44" corresp="#wit-h">Gif nasu ðyrel weorð, VIIII scillingum gebete.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">If a nose becomes pierced, let him pay with 9 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">If the nose is pierced, 9 shillings shall be paid as compensation.</ab>
