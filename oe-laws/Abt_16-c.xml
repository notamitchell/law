    <body>
      <div type="clause" n="16[c]">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 16[c]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="16[c]" corresp="#wit-h">aet þare þriddan XXX scætta.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="21.2" corresp="#wit-h">Aet þare þriddan, XXX scætta.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">For that third [rank], 30 sceattas.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">if with one of the third class, 30 sceattas.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">bei der<ptr type="liebermannNote" n="4" target="#Abt_16-c.lnote.de.4"/> dritten 30 Skätte.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">for the third, 30 sceattas.</ab>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_16-c.lnote.de.4" n="4" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">7</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Diese Form auch sonst; <hi rend="italic">s. Wb</hi> II 193 Sp. 1</seg><seg type="translation" xml:lang="en" source="#claude">This form occurs elsewhere too; <hi rend="italic">see Wb</hi> II 193 col. 1</seg></note>
      </div>
    </body>
