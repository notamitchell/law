        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="16[c]" corresp="#wit-h">aet þare þriddan XXX scætta.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="21.2" corresp="#wit-h">Aet þare þriddan, XXX scætta.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">For that third [rank], 30 sceattas.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">if with one of the third class, 30 sceattas.</ab>
