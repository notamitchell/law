  <text>
    <body>
      <div type="clause" n="55">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 55</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="55" corresp="#wit-h">Æt þam neglum gehwylcum scilling.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="59" corresp="#wit-h">Æt þam neglum gehwylcum, scilling.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">For each of the nails, a shilling.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">For the nails of each [of the above-mentioned fingers], 1 shilling [shall be paid as compensation].</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Bei den Nägeln, bei allen<ptr type="liebermannNote" n="1" target="#Abt_55.lnote.de.1"/> [vom 2.–5. Finger kostet Abhauen je 1] Schilling.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">For the nails, for all of them [from the 2nd to the 5th finger, cutting off costs 1] shilling [each].</ab>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_55.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">12</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Ausser dem des Daumens laut 54, 1; <hi rend="italic">vgl. Gl</hi> Fingernagel 2</seg><seg type="translation" xml:lang="en" source="#claude">Except that of the thumb, according to 54, 1; <hi rend="italic">cf. Gl</hi> Fingernagel 2</seg></note>
      </div>
    </body>
