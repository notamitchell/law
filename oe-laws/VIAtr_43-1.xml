    <body>
      <div type="clause" n="43.1">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 43.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="43.1" corresp="#wit-d-incomplete">⁊ freolsa ⁊ fæstena rihtlice healdan.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="43[b]" corresp="#wit-k">⁊ freolsa ⁊ fæstena rihtlice healdan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k">and freolsa and fæstena rihtlice healdan.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k">and duly observe festivals and fasts.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k">and feasts and fasts properly kept.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">und Feiertage und Fasten richtig halten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and keep feasts and fasts rightly.</ab>
        <note type="comparison" source="#liebermann" n="259"><ref target="clause:VIAtr_22">VI Atr 22</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 22</note>
      </div>
