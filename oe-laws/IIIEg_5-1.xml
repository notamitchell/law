      <div type="clause" n="5.1">
        <head><ref type="lawCode" target="law:IIIEg">III Eg</ref> 5.1</head>
        <ab type="selectedText" xml:lang="und">⁊ hæbbæ man þriwa on geare buruhgemot ⁊ tuwa scirgemot.</ab>
        <ab type="translation" xml:lang="en">And the borough court shall be held three times in the year and the county court twice.</ab>
