  <text>
    <body>
      <div type="clause" n="32">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 32</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="32" corresp="#wit-d">Gif pr<hi rend="italic">eost</hi> oðru<hi rend="italic">m</hi> rihtes fultumes forwyrne, gebete þ<hi rend="italic">æt</hi>.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d">If a priest refuses lawful help to another, he is to compensate for it.</ab>
        <ab type="translation" xml:lang="en" source="#rabin" corresp="#wit-d">If a priest denies rightful assistance to another,</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn éin Priester dem anderen zum Recht Beistand weigert, büsse er das.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If one priest refuses another lawful aid, let him atone for it.</ab>
      </div>
    </body>
