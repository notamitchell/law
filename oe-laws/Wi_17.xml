  <text>
    <body>
      <div type="clause" n="17">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 17</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17" corresp="#wit-h">Mynstres aldor hine cænne in preostes canne.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="13" corresp="#wit-h">Mynstres aldor hine cænne in preostes canne.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">The head of a minster should exculpate himself as per a priest’s exculpation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">The head of a monastery shall clear himself by the formula used by a priest.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Ein Klostervorsteher reinige sich in [derselben Form wie] Priesters Reinigung.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The head of a monastery is to clear himself in [the same form as] a priest’s exculpation.</ab>
      </div>
    </body>
