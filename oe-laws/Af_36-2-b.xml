    <body>
      <div type="clause" n="36.2[b]">
        <head><ref type="lawCode" target="law:Af">Af</ref> 36.2[b]</head>
        <ab type="selectedText" xml:lang="und">Gif hie sien bu gelic, ord ⁊ hindeweard sceaft, þæt sie butan pleo.</ab>
        <ab type="translation" xml:lang="en">If they are equal in height, the point and the shaft in the back, that shall not be considered danger[ous intention].</ab>
        <ab type="secondTranslation" xml:lang="en">If they are both on a level, the point end and the [other] end of the shaft, the man with the spear shall not be regarded as responsible for causing danger.</ab>
        <ab type="supplementaryText" xml:lang="und">Gif hy syn bú gelic, ord ⁊ hindeweard sceaft, ðæt sy buton pleo.</ab>
      </div>
    </body>
