      <div type="clause" n="1[d]">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 1[d]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1[d]" corresp="#wit-h">Diacones feoh VIgylde.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="4" corresp="#wit-h">Diacones feoh VI gylde.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">A deacon’s property [is to be compensated] with 6[-fold] compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">a deacon’s property six fold;</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Diakons Gut 6fach,</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">a deacon’s property 6-fold,</ab>
