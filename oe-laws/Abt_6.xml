    <body>
      <div type="clause" n="6">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 6</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="6" corresp="#wit-h">Gif man frigne mannan ofsleahþ, cyninge L scill' to drihtinbeage.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="12" corresp="#wit-h">Gif man frigne mannan of sleahþ, cyninge L scilƚ to drihtinbeage.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">If a person kills a free man, 50 shillings to the king as lord-payment.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">If a man slays a free man, he shall pay 50 shillings to the king for infraction of his seignorial rights.</ab>
      </div>
