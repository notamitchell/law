    <body>
      <div type="clause" n="El. 4">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 4" corresp="#wit-h">Ara þinu<hi rend="italic">m</hi> fæder ⁊ þinre meder, þa þe Drihten sealde, þ<hi rend="italic">æt</hi> ðu sy þe leng libbende on eorðan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 4" corresp="#wit-e">Ara ðinum fæder ⁊ þinre medder, ða þe Dryhten sealde, þæt ðu sie þy leng libbende on eorþan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 4" corresp="#wit-g-prol-only">Ara ðinu<hi rend="italic">m</hi> fæder ⁊ þinre meder, ða þe Drihten sealde, þ<hi rend="italic">æt</hi> ðu sie ðy leng libbende on eorþan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 4" corresp="#wit-q">Honora patrem tuum et matrem tuam, ut sis longeuus super terram quam dominus Deus tuus dabit tibi.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 4" corresp="#wit-e">Ara ðinum fæder ⁊ þinre medder, ða þe Dryhten sealde, þæt ðu sie þy leng libbende on eorþan.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">Honor your father and mother, they whom the Lord gave you, so that you may live long on the earth.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Ehre deinen Vater und deine Mutter, die dir der Herr gab, auf dass du desto länger lebest auf Erden.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Honour your father and your mother, whom the Lord gave you, so that you may live the longer on earth.</ab>
        <note type="passageSource">Exodus 20,12</note>
      </div>
    </body>
