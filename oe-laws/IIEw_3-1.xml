    <body>
      <div type="clause" n="3.1">
        <head><ref type="lawCode" target="law:IIEw">II Ew</ref> 3.1</head>
        <ab type="selectedText" xml:lang="und">Gif he nyte, hwa hine on borh nime, þonne niman þa ðe hit togebyreð on his æhtan inborh.</ab>
        <ab type="translation" xml:lang="en">If he knows no one who shall stand surety for him, those concerned may take security from his property.</ab>
        <ab type="supplementaryText" xml:lang="und">Gyf he nyte, hwa hine on borh nime, ðonne niman ða ðe hit togebyreð on his æhtan inborh.</ab>
      </div>
