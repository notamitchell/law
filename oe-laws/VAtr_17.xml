    <body>
      <div type="clause" n="17">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 17</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17" corresp="#wit-g">⁊ fæstan ælce Frigedæg, butan hit freols sy.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17" corresp="#wit-g2">⁊ fæstan ælce Frigedæg, butan hit freols sy.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="17" corresp="#wit-d">⁊ fæstan ælce Frigedæg, buton hit freols sy.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g">And fæstan ælce Frigedæg butan hit freols sy.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d">And a fast [shall be observed] every Friday, unless it be a festival.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g">And there shall be a fast each Friday unless it is a feast.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g">And there is to be a fast every Friday, except when it is a feast-day.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Und jeden Freitag, ausser wenn es ein Fest ist, fasten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and fast every Friday, unless it is a feast-day.</ab>
        <note type="comparison" source="#liebermann" n="241"><ref target="clause:IIEg_5-1">II Eg 5.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. II Eg. 5, 1</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIAtr_24">VI Atr 24</ref></note>
        <note type="comparison" source="#wormald-mel" n="340"><label>parallel (VI version)</label> <ref target="clause:VIAtr_24">VI Atr 24</ref> <quote>n. 351: V Atr 17 (VI 24)</quote></note>
        <note type="comparedBy" source="#wormald-mel" n="314"><ref target="clause:IIEg_2-3">II Eg 2.3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="314"><ref target="clause:IIEg_5-1">II Eg 5.1–3</ref></note>
        <note type="comparedBy" source="#whitelock" n="435"><ref target="clause:IIEg_5-1">II Eg 5.1</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="314"><ref target="clause:IIIEg_8-1">III Eg 8.1–3</ref></note>
