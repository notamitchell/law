    <body>
      <div type="clause" n="21">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 21</head>
        <ab type="selectedText" xml:lang="und">Gif man cirican nydþeowige, gebete þæt be lahslihte.</ab>
        <ab type="translation" xml:lang="en">If anyone brings a church under subjection, he is to pay compensation with lahslit.</ab>
        <ab type="secondTranslation" xml:lang="en">If anyone compels service from a church, he is to compensate for that with lahslit.</ab>
      </div>
