    <body>
      <div type="clause" n="El. 38">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 38</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 38" corresp="#wit-h">Ðine teoþan sceattas ond þinne frumripan gongendes ond weaxendes agif ðu Gode.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 38" corresp="#wit-e">Þine teoðan sceattas ⁊ þine fru<hi rend="italic">m</hi>ripan gongendes ⁊ weaxendes agif þu Gode.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 38" corresp="#wit-q">Decimas tuas et primitias non tardabis offerre.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 38" corresp="#wit-e">Þine teoðan sceattas ⁊ þine fru<hi rend="italic">m</hi>ripan gongendes ⁊ weaxendes agif þu Gode.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">The tenth part of your money and your first fruits of animals and crops you will give to God.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Deine zehnten Werthstücke und deine Erstlinge vom Gehenden und Wachsenden gieb du Gott.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Give to God your tenth valuables and your first-fruits of what walks and what grows.</ab>
        <note type="passageSource">Exodus 22,29</note>
      </div>
    </body>
