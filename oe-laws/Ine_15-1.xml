    <body>
      <div type="clause" n="15.1">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 15.1</head>
        <ab type="selectedText" xml:lang="und">Se að sceal bion healf be huslgengum.</ab>
        <ab type="translation" xml:lang="en">The oath shall be half for a communicant.</ab>
        <ab type="secondTranslation" xml:lang="en">An oath equal in value to half the amount shall be shall be sufficient in the case of communicants.</ab>
        <ab type="supplementaryText" xml:lang="und">Se að sceal beon healf be huslgengum.</ab>
      </div>
