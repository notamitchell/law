  <text>
    <body>
      <div type="clause" n="1">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1" corresp="#wit-h">Cirice an freolsdome gafola;</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="1" corresp="#wit-h">Ciricean freolsdom(e) gafola;</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">Freedom of the church from taxation [is to be];</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">The Church shall enjoy immunity from taxation.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">The Church [is to be] free from taxation.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Die Kirche [sei] in Freiheit von Abgaben;</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The Church [is to be] in freedom from taxes;</ab>
      </div>
    </body>
