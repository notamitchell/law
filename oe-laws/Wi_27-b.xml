    <body>
      <div type="clause" n="27 [b]">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 27 [b]</head>
        <ab type="selectedText" xml:lang="und">Gif hine man acwelle, þam agende hi[ne] man healfne agelde.</ab>
        <ab type="translation" xml:lang="en">If he [the slave] is put to death, one should pay the owner half his [the slave’s] value.</ab>
        <ab type="supplementaryText" xml:lang="und">gif hine man acwelle, þam agende hi man healfne agelde.</ab>
