  <text>
    <body>
      <div type="clause" n="47">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 47</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="47" corresp="#wit-h">Gif butu ðyrele sien, VI scill' gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="44.2" corresp="#wit-h">Gif butu ðyrele sien, VI sciƚƚ gebete.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">If both [cheeks] should be pierced, let him pay [with] 6 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">If both are pierced, 6 shillings shall be paid as compensation.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn beide [Wangen] durchstochen sind, büsse er 6<ptr type="liebermannNote" n="1" target="#Abt_47.lnote.de.1"/> Schill.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If both [cheeks] are pierced through, let him pay 6 shillings.</ab>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_47.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">11</biblScope><biblScope unit="column">2</biblScope></bibl><seg type="original" xml:lang="de">Verdoppelt wie <hi rend="italic">o.</hi> 36f.</seg><seg type="translation" xml:lang="en" source="#claude">Doubled as <hi rend="italic">above</hi> 36f.</seg></note>
      </div>
    </body>
