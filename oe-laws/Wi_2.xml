    <body>
      <div type="clause" n="2">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-h">Ciricean mundbyrd sie L scll' swa cinges.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="2" corresp="#wit-h">Ciricean mundbyrd sie L scƚƚ, swa cinges.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">[Violation of the] protection of the church shall be 50 shillings, as the king’s.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">The <hi rend="italic">mundbyrd</hi> of the Church shall be 50 shillings like the king’s.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Der Kirche Sonderschutz sei [von seinem Verletzer ihr zu büssen mit] 50 Schll., wie der des Königs.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The Church’s special protection is to be [compensated to it by the one who violates it with] 50 shillings, like the king’s.</ab>
      </div>
