        <head><ref type="lawCode" target="law:Abt">Abt</ref> 1[a]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1[a]" corresp="#wit-h">Godes feoh ⁊ ciricean XIIgylde.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="1" corresp="#wit-h">Godes feoh ⁊ ciricean XII gylde.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">God’s property and the church’s [is to be compensated] with 12[-fold] compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">[Theft of] God’s property and the Church’s shall be compensated twelve fold;</ab>
