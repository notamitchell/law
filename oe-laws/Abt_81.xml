    <body>
      <div type="clause" n="81">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 81</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="81" corresp="#wit-h">Gif hio bearn ne gebyreþ, fæderingmagas fioh agan ⁊ morgengyfe.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="76.5" corresp="#wit-h">Gif hio bearn ne gebyreþ, fæderingmagas fioh agan ⁊ morgengyfe.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">If she does not bear a child, her paternal kin should obtain [her] property and the morning-gift.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">If she does not bear a child, [her] father’s relatives shall have her goods, and the “morning gift.”</ab>
      </div>
