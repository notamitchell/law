    <body>
      <div type="clause" n="26.4">
        <head>Cn 1018 26.4</head>
        <ab type="editionText" xml:lang="ang" source="#kennedy" n="26.4" corresp="#wit-d">Swá wið ælc þara gif hit swa gewurðe on engla lage.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d">swa wið ælc þara gif hit swa gewurðe on Engla lage.</ab>
        <ab type="translation" xml:lang="en" source="#kennedy" corresp="#wit-d">To all of them if this is the outcome in the English jurisdiction.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d">thus to all of them if it is appropriate in areas under English law.</ab>
      </div>
