    <body>
      <div type="clause" n="61">
        <head><ref type="lawCode" target="law:Af">Af</ref> 61</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61" corresp="#wit-e"><pb n="82" ed="#liebermann"/>Gif mon bið on hrif wund<ptr type="liebermannNote" n="21" target="#Af_61.lnote.oe.21"/>, geselle him mon XXX scill. to<ptr type="liebermannNote" n="17" target="#Af_61.lnote.oe.17"/> bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61" corresp="#wit-h"><pb n="82" ed="#liebermann"/>Gif mon<ptr type="liebermannNote" n="1" target="#Af_61.lnote.oe.1"/> bið on hrif<ptr type="liebermannNote" n="9" target="#Af_61.lnote.oe.9"/> wund, gesylle<ptr type="liebermannNote" n="10" target="#Af_61.lnote.oe.10"/> him mon<ptr type="liebermannNote" n="1" target="#Af_61.lnote.oe.1"/> XXX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="61" corresp="#wit-b-no-prol"><pb n="82" ed="#liebermann"/>Gyf mon rifwund<ptr type="liebermannNote" n="4" target="#Af_61.lnote.oe.4"/> bið, gesylle him mon ðrittig scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="61" corresp="#wit-q"><pb n="83" ed="#liebermann"/>Si<ptr type="liebermannNote" n="20" target="#Af_61.lnote.oe.20"/> quis in ilibus uulneretur, sit<ptr type="liebermannNote" n="21" target="#Af_61.lnote.oe.21-2"/> emendatio XXX solid.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="88" ed="#attenborough"/>Gif mon bið on hrif wund<ptr type="editorNote" n="15" target="#Af_61.attnote.fn.15"/>, geselle him mon XXX scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="64" corresp="#wit-e"><pb n="356" ed="#jurasinski-and-oliver"/>Gif mon bið on hrif wund, geselle him mon XXX scill to bote</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="83" ed="#liebermann"/>Wenn<ptr type="liebermannNote" n="1" target="#Af_61.lnote.de.1"/> jemand am<ptr type="liebermannNote" n="2" target="#Af_61.lnote.de.2"/> Bauch<ptr type="liebermannNote" n="3" target="#Af_61.lnote.de.3"/> verwundet ist, gebe man ihm 30 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If someone is wounded in the belly, let him be given 30 shillings as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="89" ed="#attenborough"/>If a man is wounded in the belly, 30 shillings shall be given to him as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="357" ed="#jurasinski-and-oliver"/>If someone is wounded in the abdomen, let him be paid 30 shillings as compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61.lnote.oe.21" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">gewundod, gesylle <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">gewundod, gesylle Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61.lnote.oe.17" n="17" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">to b. <hi rend="italic">fehlt Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">to b. lacking in Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">o <hi rend="italic">geänd. in</hi> a</seg><seg type="translation" xml:lang="en" source="#claude">o altered to a</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61.lnote.oe.9" n="9" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. in</hi> hrife</seg><seg type="translation" xml:lang="en" source="#claude">altered to hrife</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61.lnote.oe.10" n="10" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61.lnote.oe.20" n="20" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">c.</hi> 61 <hi rend="italic">fehlt Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">c. 61 lacking in Br</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61.lnote.oe.21-2" n="21" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">83</biblScope></bibl><seg type="original" xml:lang="de">habeat emendationis <hi rend="italic">Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">habeat emendationis Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_61.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">82</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">im</hi> 16. <hi rend="italic">Jh. geänd. in</hi> on rife gewunded</seg><seg type="translation" xml:lang="en" source="#claude">altered in the 16th cent. to on rife gewunded</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_61.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Beeinflusst durch Abt 61</seg><seg type="translation" xml:lang="en" source="#claude">Influenced by Abt 61</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_61.lnote.de.2" n="2" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">‘bauchwund’ B. — Über <hi rend="italic">grin</hi> in Inst. <hi rend="italic">s.</hi> Thöne 56</seg><seg type="translation" xml:lang="en" source="#claude">‘wounded in the belly’ B. — On <hi rend="italic">grin</hi> in Inst. <hi rend="italic">see</hi> Thöne 56</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Af_61.lnote.de.3" n="3" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">62</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">s. Gl</hi> Bauch</seg><seg type="translation" xml:lang="en" source="#claude"><hi rend="italic">see Gl</hi> Bauch</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_61.attnote.fn.15" n="15" source="#attenborough"><bibl><biblScope unit="page">88</biblScope></bibl><label>wund</label><seg type="original" xml:lang="en"><hi rend="italic">rifwund</hi>. B. Altered in 16th century to <hi rend="italic">on rife gewunded</hi>.</seg></note>
      </div>
