    <body>
      <div type="clause" n="20">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 20</head>
        <ab type="selectedText" xml:lang="und">Gif man mid cirican mangie, bete be lahslite.</ab>
        <ab type="translation" xml:lang="en">If anyone traffics with a church, he is to pay with lahslit.</ab>
        <ab type="secondTranslation" xml:lang="en">If anyone engages in trade with a church, he is to compensate for that with lahslit.</ab>
      </div>
