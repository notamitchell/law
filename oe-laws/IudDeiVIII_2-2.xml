  <text>
    <body>
      <div type="clause" n="2.2">
        <head><ref type="lawCode" target="law:IudDeiVIII">Iud Dei VIII</ref> 2.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.2" corresp="#wit-ca">ne ðe nán scincræft ne gehelppe togeanes ðisum Godes dome.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">und keine Zauberkunst helfe dir gegen dieses Gottesgericht.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and may no sorcery help you against this judgment of God.</ab>
        <ab type="translation" xml:lang="en" source="#unattributed" corresp="#wit-ca">and no magic art will help you against this judgment of God.</ab>
      </div>
    </body>
