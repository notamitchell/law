  <text>
    <body>
      <div type="clause" n="7">
        <head><ref type="lawCode" target="law:NorGrith">Nor Grið</ref> 7</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7" corresp="#wit-g-b">[?preost]e cyricgangas syndan forbodene</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" n="3" corresp="#wit-g-b">And preoste cyricgangas syndan forbodene</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">[Fortsetzung von 3]</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">[Continuation of clause 3; see line 6.]</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g-b">[3] And a priest is forbidden from attending church with women or</ab>
        <note type="editorial">The bracketed ‘[?preost]e’ is Liebermann's conjecture.; T: corrected against Rabin, DOML 66 (2020), p. 32 (before: ‘Andpreoste cyricgangas syndan forbodene wifum 7 wæpnum.’)</note>
        <note type="textual" source="#rabin-doml">And preoste: reconstructed by Liebermann</note>
        <note type="textual" source="#rabin-doml">forbodene wifum: Liebermann supplies mid after forbodene</note>
        <note type="translator" source="#rabin-doml">“And a priest” is reconstructed.</note>
      </div>
    </body>
