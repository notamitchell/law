  <text>
    <body>
      <div type="clause" n="8.1">
        <head><ref type="lawCode" target="law:IIIAtr">III Atr</ref> 8.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="8.1" corresp="#wit-q">Et nullus habeat aliquem monetarium nisi rex.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="8.1" corresp="#wit-h">And nan mann ne áge nǽnne mynetere buton cyng.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="8.1" corresp="#wit-h">And nan mann ne áge nænne mynetere buton cyng.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-h">And no-one except the king shall have a moneyer.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">And no one except the king is to have a moneyer.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Und niemand als der König habe einen Münzer.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let no one but the king have a moneyer.</ab>
        <note type="editorial">H's ‘ne áge’ is written as one word ‘neáge’.</note>
      </div>
    </body>
  </text>
