    <body>
      <div type="clause" n="85">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 85</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="85" corresp="#wit-h">Gif man mid esnes cwynan geligeþ be cwicum ceorle, II gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="78" corresp="#wit-h">Gif man mid esnes cwynan geligeþ be cwicum ceorle, II gebete.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">If a person lies with a servant’s wife while the husband is alive, let him pay 2[-fold what he would have paid were she unmarried].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">If a man lies with the woman of a servant, during the lifetime of the husband, he shall pay a twofold compensation.</ab>
      </div>
