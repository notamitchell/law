      <div type="clause" n="85">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 85</head>
        <ab type="selectedText" xml:lang="und">Gif man mid esnes cwynan geligeþ be cwicum ceorle, II gebete.</ab>
        <ab type="translation" xml:lang="en">If a person lies with a servant’s wife while the husband is alive, let him pay 2[-fold what he would have paid were she unmarried].</ab>
        <ab type="supplementaryText" xml:lang="und">Gif man mid esnes cwynan geligeþ be cwicum ceorle, II gebete.</ab>
