    <body>
      <div type="clause" n="17[b]">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 17[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="17[b]" corresp="#wit-h">se þe æfter irneþ: III scillingas,</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="22.1" corresp="#wit-h">Se þe æfter irneþ, III scillingas.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">He who breaks in next, 3 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">He who comes next shall pay 3 shillings compensation;</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">he who enters next, three shillings;</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">der, welcher [gleich] nachher<ptr type="liebermannNote" n="5" target="#Abt_17-b.lnote.de.5"/> [hinein] dringt, 3 Schillinge,</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">the one who forces his way [in] [immediately] after, 3 shillings;</ab>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Abt_17-b.lnote.de.5" n="5" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">7</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Der erste Verbrecher büsst mehr als das Gefolge; <hi rend="italic">vgl.</hi> Osenbrüggen <hi rend="italic">Stud. Dt. u. Schweiz. RG</hi> 264</seg><seg type="translation" xml:lang="en" source="#claude">The first offender pays more compensation than his followers; <hi rend="italic">cf.</hi> Osenbrüggen <hi rend="italic">Stud. Dt. u. Schweiz. RG</hi> 264</seg></note>
      </div>
    </body>
