      <div type="clause" n="13.1">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 13.1</head>
        <ab type="selectedText" xml:lang="und">Oþer: þæt ælc ceaping sy binnon port.</ab>
        <ab type="translation" xml:lang="en">Secondly, that all trading shall be carried out in a town.</ab>
        <ab type="supplementaryText" xml:lang="und">Oþær: ylc ceapunge sy binnan porte.</ab>
