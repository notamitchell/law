    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:IAtr">I Atr</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-h">Gyf he ðonne tyhtbysig sy, gange to þ<hi rend="italic">am</hi> þryfealdan ordale.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-b">Gyf he ðonne tyhtbysig sy, gange to ðam ðreofealdan ordale.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q">Si tyhtbisi sit (id est accusationibus infamatus), ad triplex ordalium uadat.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1.1" corresp="#wit-b">Gyf he ðonne tyhtbysig sy, gange to ðam ðreofealdan ordale.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn [Angeklagt]er nun oft bescholten ist, gehe er zum dreifachen Ordal.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the [accused] is then of bad repute, let him go to the threefold ordeal.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-b">If, however, he is of bad reputation, he shall go to the triple ordeal.</ab>
        <note type="comparison" source="#liebermann" n="217"><ref target="clause:IIIAtr_3-4">III Atr 3.4</ref></note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. III Atr. 3, 4</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:IIIAtr_3-4">III Atr 3.4</ref>; <ref target="clause:IICn_22">II Cn 22</ref>; <ref target="clause:IICn_30">II Cn 30</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="358"><ref target="clause:IICn_30">II Cn 30</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="367"><ref target="clause:IICn_30-1">II Cn 30.1</ref></note>
        <note type="editorial">Liebermann compares III Atr 3, 4.</note>
      </div>
