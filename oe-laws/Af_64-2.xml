    <body>
      <div type="clause" n="64.2">
        <head><ref type="lawCode" target="law:Af">Af</ref> 64.2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64.2" corresp="#wit-e"><pb n="84" ed="#liebermann"/>Gif seo midleste<ptr type="liebermannNote" n="6" target="#Af_64-2.lnote.oe.6"/> ta sie ófaslegen, þær sculon VIIII<ptr type="liebermannNote" n="7" target="#Af_64-2.lnote.oe.7"/> scill. to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64.2" corresp="#wit-h"><pb n="84" ed="#liebermann"/>Gif seo midlæste tá sy<ptr type="liebermannNote" n="3" target="#Af_64-2.lnote.oe.3"/> ofaslægen, ðær sculon IX scll' to bote.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="64.2" corresp="#wit-b-no-prol"><pb n="84" ed="#liebermann"/>Gyf seo midlæste tá sy ofaslagen, ðær scylan nigon scill' to bote.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="64.2" corresp="#wit-q"><pb n="85" ed="#liebermann"/>si tercius, IX; si quartus, VI sol.<ptr type="liebermannNote" n="6" target="#Af_64-2.lnote.oe.6-2"/>; si minimus, quinque sol. emendetur<ptr type="liebermannNote" n="4" target="#Af_64-2.lnote.oe.4"/> (constet).</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-e"><pb n="90" ed="#attenborough"/>Gif seo midleste ta sie ófaslegen, þær sculon<ptr type="editorNote" n="3" target="#Af_64-2.attnote.fn.3"/> VIIII scill. to bote.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="67.2" corresp="#wit-e"><pb n="358" ed="#jurasinski-and-oliver"/>Gif seo midleste ta sie ófaslegen, þær sculon VIIII scill to bote.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="85" ed="#liebermann"/>Wenn die mittelste Zehe abgehauen ist, da gehören 9 Schill. zur Busse.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the middle toe is cut off, 9 shillings are due as compensation.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e"><pb n="91" ed="#attenborough"/>If the middle toe is struck off, 9 shillings must be paid as compensation for it.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="359" ed="#jurasinski-and-oliver"/>If the middle toe is struck off, 9 shillings shall be the compensation.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-2.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">-sta tá sy ofaslagen <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">-sta tá sy ofaslagen Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-2.lnote.oe.7" n="7" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">nigon <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">nigon Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-2.lnote.oe.3" n="3" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">84</biblScope></bibl><seg type="original" xml:lang="de">y <hi rend="italic">auf Rasur</hi></seg><seg type="translation" xml:lang="en" source="#claude">y on an erasure</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-2.lnote.oe.6-2" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">nur Lond</hi></seg><seg type="translation" xml:lang="en" source="#claude">only Lond</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Af_64-2.lnote.oe.4" n="4" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">85</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">vor der Klammer Lesart Lond;</hi> (<hi rend="italic">eingeklammertes</hi>) <hi rend="italic">übrige</hi></seg><seg type="translation" xml:lang="en" source="#claude">reading of Lond before the bracket; (the bracketed words) the others</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="Af_64-2.attnote.fn.3" n="3" source="#attenborough"><bibl><biblScope unit="page">90</biblScope></bibl><label>sculon</label><seg type="original" xml:lang="en"><hi rend="italic">scylan</hi>. B.</seg></note>
      </div>
