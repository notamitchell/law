    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:Wer">Wer</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-b">Twyhyndes mannes wer is twa hund scill'.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1" corresp="#wit-q">Ƿihindi hominis wera est ƿa hund scill. (id est ducenti sol. ex V scilicet denariis, qui faciunt IIII libras et XL denarios).</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.1" corresp="#wit-h">Twyhyndes mannes wer is twa hund scill'.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wergeld eines 200-Menschen ist 200 Schilling.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The wergild of a two-hundred man is 200 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#wormald" corresp="#wit-h">A two-hundred man's wergeld is 200 shillings</ab>
        <note type="comparedBy" source="#liebermann"><ref target="clause:LeisWl_8">Leis Wl 8</ref></note>
      </div>
