  <text>
    <body>
      <div type="clause" n="58">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 58</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58" corresp="#wit-h">Oxan horn bið teon peninga weorð.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="58" corresp="#wit-e">CII. Oxan horn bið X pæninga weorð.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="58" corresp="#wit-q">Bouis cornu ualet (debet emendari) decem denariis;</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="62" corresp="#wit-e">{CII} Oxan horn bið X pæninga weorð.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">An ox horn is worth 10 pennies.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-e">The horn of an ox is worth 10 pence.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock">The horn of an ox is valued at tenpence.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Eines Ochsen Horn ist 10 Pfennige werth.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">An ox’s horn is worth 10 pence.</ab>
      </div>
    </body>
