    <body>
      <div type="clause" n="1.4">
        <head><ref type="lawCode" target="law:VAs">V As</ref> 1.4</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-ld">And gif hit sy ðegn ðe hit dó, sy þ<hi rend="italic">æt</hi> ylc.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="1.4" corresp="#wit-h">⁊ gif hit sy ðegen ðe hit dó, sy þæt ilce.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.4" corresp="#wit-q">Et si thainus sit, idem faciat.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" n="1.4" corresp="#wit-h">⁊ gif hit sy ðegen þe hit dó, sy þæt ilce.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">And if it is a thegn who acts thus, the same punishment shall be inflicted.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock">And if it is a thegn who does it, it is to be the same.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Und wenn es ein Thegn ist, der es thut, sei das ebenso.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And if it is a thegn who does it, let it be the same.</ab>
      </div>
    </body>
