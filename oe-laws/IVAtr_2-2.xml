    <body>
      <div type="clause" n="2.2">
        <head><ref type="lawCode" target="law:IVAtr">IV Atr</ref> 2.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.2" corresp="#wit-q">De naui plena lignorum unum lignum ad tol'.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="2.2" corresp="#wit-q">De navi plena lignorum—unum lignum ad tol'.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Von einem Schiff voll Hölzern ein Brett als Zoll.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">From a ship full of timber, one plank as toll.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q">From a ship with a cargo of planks, one plank is given as toll.</ab>
      </div>
