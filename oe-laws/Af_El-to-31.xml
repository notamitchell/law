    <body>
      <div type="clause" n="El. 31">
        <head><ref type="lawCode" target="law:Af">Af</ref> El. 31</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 31" corresp="#wit-h">And se þe hæme mid nytene, swelte se deaþe.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="El. 31" corresp="#wit-e">⁊ se ðe hæme mid netene, swelte he deaðe.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="El. 31" corresp="#wit-q">Qui coierit cum iumento, morte moriatur.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" n="MP 31" corresp="#wit-e">⁊ se ðe hæme mid netene, swelte he deaðe.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">He who lies with cattle, let him die [the] death.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Und wer mit Vieh sich gattet, er sterbe Todes.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And whoever couples with a beast, let him die the death.</ab>
        <note type="passageSource">Exodus 22,19</note>
        <note type="comparison" source="#liebermann" n="39">Exodus 22.19</note>
        <note type="comparisonPrinted" source="#liebermann">[22, 19]</note>
      </div>
