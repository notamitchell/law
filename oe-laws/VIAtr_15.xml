  <text>
    <body>
      <div type="clause" n="15">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 15</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="15"><pb n="250" ed="#liebermann"/>[Not in D]</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-k"><pb n="250" ed="#liebermann"/>K. ⁊ ænig man heonan forð cyrican ne þowige<ptr type="liebermannNote" n="**" target="#VIAtr_15.lnote.oe.star2"/>, ne cyricmangunge mid unrihte ne macige,</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="15[a]" corresp="#wit-k"><pb n="96" ed="#robertson"/>⁊ ænig man heonan forð cyrican ne þ[e]owige<ptr type="editorNote" n="1" target="#VIAtr_15.robnote.fn.1"/> ne cyricmangunge mid unrihte ne macige,</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k"><pb n="166" ed="#rabin-doml"/>And ænig man heonan forð cyrican ne þeowige, ne cyricmangunge mid unrihte ne macige.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="250" ed="#liebermann"/>Und niemand<ptr type="liebermannNote" n="1" target="#VIAtr_15.lnote.de.1"/> unterwerfe hinfort eine Kirche einer Dienstpflicht oder treibe gesetzwidrig mit Kirchen Handel</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let no one henceforth subject a church to servitude, or unlawfully traffic in churches,</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k"><ptr type="editorNote" n="1" target="#VIAtr_15.robnote.n.1"/><pb n="97" ed="#robertson"/>And no-one henceforth shall oppress the church, or make it an object of improper traffic,</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k"><pb n="167" ed="#rabin-doml"/>And henceforth no one shall persecute the Church, nor wrongfully make it an object of exchange.</ab>
        <note type="comparison" source="#liebermann" n="250">[?]</note>
        <note type="comparisonPrinted" source="#liebermann">Vgl. [?] 10[?]</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:Northu_20">Northu 20</ref>; <ref target="clause:Northu_21">Northu 21</ref></note>
        <note type="editorial">K's ‘þowige’ should be corrected to ‘þeowige’.</note>
        <note type="textual" source="#rabin-doml">þeowige: þowige K</note>
        <note type="liebermannNote" subtype="textual" xml:id="VIAtr_15.lnote.oe.star2" n="**" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">250</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">bessere</hi> þeow.; <hi rend="italic">vgl.</hi> 3, 1</seg><seg type="translation" xml:lang="en" source="#claude">read þeow.; cf. 3, 1</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="VIAtr_15.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">175</biblScope><biblScope unit="column">3</biblScope></bibl><seg type="original" xml:lang="de">Benutzt durch Northu 20—22. Zu <hi rend="italic">Christi servitute levissima</hi> der Paraphrase <hi rend="italic">vgl. o</hi>. 2{a}</seg><seg type="translation" xml:lang="en" source="#claude">Used by Northu 20—22. On the Paraphrase’s <hi rend="italic">Christi servitute levissima</hi> <hi rend="italic">cf. above</hi> 2{a}</seg><note type="remark" resp="#claude">On several rubrics: VI Atr 15. 15, 1</note></note>
        <note type="editorNote" subtype="endnote" xml:id="VIAtr_15.robnote.n.1" n="1" source="#robertson"><bibl><biblScope unit="page">333</biblScope></bibl><seg type="original" xml:lang="en">Cf. V, 10, 2; <hi rend="italic">N.P.L.</hi> 20–2</seg></note>
        <note type="editorNote" subtype="footnote" xml:id="VIAtr_15.robnote.fn.1" n="1" source="#robertson"><bibl><biblScope unit="page">96</biblScope></bibl><label>þ[e]owige</label><seg type="original" xml:lang="en"><hi rend="italic">þow.</hi> K.</seg></note>
      </div>
