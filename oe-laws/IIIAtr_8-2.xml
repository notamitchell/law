    <body>
      <div type="clause" n="8.2">
        <head><ref type="lawCode" target="law:IIIAtr">III Atr</ref> 8.2</head>
        <ab type="selectedText" xml:lang="und">⁊ ælc mynetere þe betihtlad sí, bicge him láh mid XII oran.</ab>
        <ab type="translation" xml:lang="en">And every moneyer who is accused shall pay 12 ores in order to obtain the benefit of the law.</ab>
        <ab type="supplementaryText" xml:lang="und">Et omnis monetarius qui infamis sit, redimat sibi lagam XII oris.</ab>
      </div>
