      <div type="clause" n="78">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 78</head>
        <ab type="selectedText" xml:lang="und">Gif hio cwic bearn gebyreþ, healfne scæt age gif ceorl ær swylteþ.</ab>
        <ab type="translation" xml:lang="en">If she bears a living child, let her obtain half the goods [belonging to the household] if the husband dies first.</ab>
        <ab type="supplementaryText" xml:lang="und">Gif hio cwic bearn gebyreþ, healfne scæt age, gif ceorl ær swylteþ.</ab>
