        <head><ref type="lawCode" target="law:Abt">Abt</ref> 12</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="12" corresp="#wit-h">Cyninges fedesl XX scillinga forgelde.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="17" corresp="#wit-h">Cyninges fedesl, XX scillinga forgelde.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">[For] feeding of the king, let him pay 20 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">20 shillings shall be paid for killing a <hi rend="italic">fedesl</hi> belonging to the king.</ab>
