  <text>
    <body>
      <div type="clause" n="1.1">
        <head><ref type="lawCode" target="law:VIAtr">VI Atr</ref> 1.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.1">[Not in D]</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="1[b]" corresp="#wit-k">⁊ anum cynehlaforde holdlice hyran ⁊ georne hine healdan mid rihtan getrywðan.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-k">and anum cynehlaforde holdlice hyran and georne hine healdan mid rihtan getrywðan.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-k">and loyally obey one royal lord, and readily support him with due fidelity.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-k">and loyally obey one royal lord, and willingly follow him with proper devotion.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">und Einem königlichen Herrn getreu gehorchen und mit rechter Treue willig an ihm festhalten.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">and loyally obey one royal lord and willingly hold to him with true fidelity.</ab>
        <note type="comparison" source="#liebermann" n="246">V Atr 1[?]</note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 1[?]</note>
        <note type="comparisonIncomplete">Some of Liebermann’s notes here are cut off in the gutter of the scan used, and are still to be completed.</note>
        <note type="comparedBy" source="#liebermann"><ref target="clause:VIIIAtr_44-1">VIII Atr 44.1</ref>; <ref target="clause:ICn_1">I Cn 1</ref></note>
        <note type="comparedBy" source="#kennedy" n="59"><ref target="clause:Cn-1018_part-002">Cn 1018 1</ref></note>
      </div>
    </body>
