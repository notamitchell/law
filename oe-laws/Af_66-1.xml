    <body>
      <div type="clause" n="66.1">
        <head><ref type="lawCode" target="law:Af">Af</ref> 66.1</head>
        <ab type="selectedText" xml:lang="und">Æghwelcere wunde beforan feaxe ⁊ beforan sliefan ⁊ beneoðan cneowe sio bot bið twysceatte mare.</ab>
        <ab type="translation" xml:lang="en">Any wound below the hairline, and below the sleeve, and beneath the knee is two-fold more.</ab>
        <ab type="secondTranslation" xml:lang="en">For every wound in front of the hair, and below the sleeve and beneath the knee, the compensation shall be doubled.</ab>
        <ab type="supplementaryText" xml:lang="und">Æghwylcre wunde beforan feaxe ⁊ beforan slyfon ⁊ beneoþan cneowe seo bot bið twysceatte mare.</ab>
      </div>
