    <body>
      <div type="clause" n="15">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 15</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="15" corresp="#wit-h">Ceorles mundbyrd: VI scillingas.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="20" corresp="#wit-h">Ceorles mundbyrd, VI scillingas.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">[For violation of] a freeman’s protection, 6 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">A commoner’s <hi rend="italic">mundbyrd</hi> shall be 6 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">The [breach of a] ceorl’s protection: six shillings.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Des Gemeinfreien Schutzrecht [gilt] 6 Schillinge.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">The common freeman’s right of protection [is worth] 6 shillings.</ab>
        <note type="translator" source="#whitelock">Though modern English “churl” is the direct descendant of this word, the sense has changed so much that to use it would be misleading. Its normal Old English meaning is a peasant proprietor.</note>
      </div>
    </body>
