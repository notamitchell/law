  <text>
    <body>
      <div type="clause" n="2.3">
        <head><ref type="lawCode" target="law:IIEg">II Eg</ref> 2.3</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2.3" corresp="#wit-a">⁊ gelæste man sulhælmessan, þonne XV niht beon onufan eastran.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2.3">[Not in G]</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="2.3" corresp="#wit-d">Gelæste man sulhælmessan þonne XV niht beon onufan eastran.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d">Plough-alms shall be rendered 15 days after Easter.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">(Und man leiste Pflugalmosen, wenn 15 Nächte [14 Tage vergangen] sind über Ostern. A D)</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">(And let plough-alms be paid when it is 15 nights [a fortnight] after Easter. A D)</ab>
        <note type="editorial">Not in G or Quadr.; in A and D only. Cnut (I Cn 8.1) also places it before II Eg 3.</note>
      </div>
    </body>
