      <div type="clause" n="43">
        <head>Ine Rb 43</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="43" corresp="#wit-e"><pb n="24" ed="#liebermann"/>LXXXVII. Be wuda<ptr type="liebermannNote" n="2" target="#Rubrics-Ine_43.lnote.oe.2"/> bærnette.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="43" corresp="#wit-g-prol"><pb n="24" ed="#liebermann"/>LXXXVII. Be wuda<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_43.lnote.oe.1"/> bærnette.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="43" corresp="#wit-h"><pb n="25" ed="#liebermann"/>LXXXVII. Be wudubærnette.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="43" corresp="#wit-q"><pb n="25" ed="#liebermann"/>De nemoris<ptr type="liebermannNote" n="5" target="#Rubrics-Ine_43.lnote.oe.5"/> combustione.<ptr type="liebermannNote" n="6" target="#Rubrics-Ine_43.lnote.oe.6"/></ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="208" ed="#jurasinski-and-oliver"/>LXXXVII Be wuda bærnette</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="208" ed="#jurasinski-and-oliver"/>Be wude bærnete</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><pb n="25" ed="#liebermann"/>Über Abbrennen von Waldholz.<ptr type="liebermannNote" n="1" target="#Rubrics-Ine_43.lnote.de.1"/></ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Concerning the burning of timber.</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e"><pb n="209" ed="#jurasinski-and-oliver"/>Concerning burning of wood</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b"><pb n="209" ed="#jurasinski-and-oliver"/></ab>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_43.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">geänd. aus</hi> wudu</seg><seg type="translation" xml:lang="en" source="#claude">altered from wudu</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_43.lnote.oe.2" n="2" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">24</biblScope></bibl><seg type="original" xml:lang="de">wudubærnete <hi rend="italic">Ld</hi></seg><seg type="translation" xml:lang="en" source="#claude">wudubærnete Ld</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_43.lnote.oe.5" n="5" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">-rum <hi rend="italic">T</hi></seg><seg type="translation" xml:lang="en" source="#claude">-rum T</seg></note>
        <note type="liebermannNote" subtype="textual" xml:id="Rubrics-Ine_43.lnote.oe.6" n="6" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">25</biblScope></bibl><seg type="original" xml:lang="de">Si quis alterius nemus securi apprehenderit sine licentia [43,1] <hi rend="italic">fügt zu Hk</hi>; De succidentibus ligna in nemore alterius <hi rend="italic">fügt zu Br</hi></seg><seg type="translation" xml:lang="en" source="#claude">Si quis alterius nemus securi apprehenderit sine licentia [43,1] added by Hk; De succidentibus ligna in nemore alterius added by Br</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Rubrics-Ine_43.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">42</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Q spät. Rez. vervollständigt die Rb aus seinem Text</seg><seg type="translation" xml:lang="en" source="#claude">The later recension of Q completes the Rb from its own text</seg><note type="remark" resp="#claude">On several rubrics: Ine Rb 40. 43f. 46—50. 54. 56f. 58. 61f. 67. 70f.</note></note>
