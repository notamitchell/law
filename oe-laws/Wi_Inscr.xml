    <body>
      <div type="clause" n="Inscr.">
        <head><ref type="lawCode" target="law:Wi">Wi</ref> Inscr.</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="Wi Inscr." corresp="#wit-h">Ðis<ptr type="liebermannNote" n="1" target="#Wi_Inscr.lnote.oe.1"/> synd Wihtrædes domas Cantwara cyninges.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" corresp="#wit-h">Ðis synd Wihtredes domas Cantwara cyninges.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">These are the decrees of Wihtred, king of the Kentish people.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">These are the decrees of Wihtred<ptr type="editorNote" n="1" target="#Wi_Inscr.attnote.n.1"/>, King of Kent.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-h">These are the decrees of Wihtred, king of the people of Kent.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann"><ptr type="liebermannNote" n="1" target="#Wi_Inscr.lnote.de.1"/>Dies sind Wihtreds Gesetze, des Kenterkönigs.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">These are the laws of Wihtred, king of the Kentish people.</ab>
        <note type="liebermannNote" subtype="textual" xml:id="Wi_Inscr.lnote.oe.1" n="1" source="#liebermann"><bibl><biblScope unit="volume">1</biblScope><biblScope unit="page">12</biblScope></bibl><seg type="original" xml:lang="de"><hi rend="italic">Text aus H. Inscriptio roth</hi></seg><seg type="translation" xml:lang="en" source="#claude">Text from H. Inscriptio in red</seg></note>
        <note type="liebermannNote" subtype="erklaerung" xml:id="Wi_Inscr.lnote.de.1" n="1" source="#liebermann-erkl"><bibl><biblScope unit="volume">3</biblScope><biblScope unit="page">25</biblScope><biblScope unit="column">1</biblScope></bibl><seg type="original" xml:lang="de">Die Überschrift gehört wie die zu Abt und Hl dem Kompilator; <hi rend="italic">s. o.</hi> S. 3 n. 1</seg><seg type="translation" xml:lang="en" source="#claude">The heading, like those to Abt and Hl, belongs to the compiler; see above p. 3 n. 1</seg></note>
        <note type="editorNote" subtype="endnote" xml:id="Wi_Inscr.attnote.n.1" n="1" source="#attenborough"><bibl><biblScope unit="page">180</biblScope></bibl><seg type="original" xml:lang="en">See p. 2 f. above.</seg></note>
      </div>
    </body>
