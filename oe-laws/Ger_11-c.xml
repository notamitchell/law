        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="11[c]" corresp="#wit-b">[11[c]] on odene cylne macian –</ab>
        <ab type="editionText" xml:lang="ang" source="#gobbitt" n="26.2" corresp="#wit-b">On odene cylne macian .</ab>
        <ab type="translation" xml:lang="en" source="#gobbitt" corresp="#wit-b">To make a kiln on the threshing-floor.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">auf dem Dreschplatz eine Darre machen —</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">make a kiln on the threshing-floor —</ab>
        <note type="editorial">Liebermann compares Gerefa 3.1.</note>
