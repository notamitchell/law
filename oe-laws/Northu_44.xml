  <text>
    <body>
      <div type="clause" n="44">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 44</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="44" corresp="#wit-d">Gif pr<hi rend="italic">eost</hi> sinoð forbuge, gebete þ<hi rend="italic">æt</hi>.</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d">Gif preost sinoð forbuge, gebete þæt.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-d">If a priest stays away from a synod, he is to compensate for it.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d">If a priest fails to attend a synod, he is to atone for that.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn ein Priester die Synode zu besuchen versäumt, büsse er das.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a priest fails to attend the synod, let him atone for it.</ab>
        <note type="comparison" source="#liebermann" n="382">Can. Eg. 3f.</note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 3 f.</note>
        <note type="editorial">Liebermann compares Canons of Edgar 3 f.</note>
      </div>
    </body>
