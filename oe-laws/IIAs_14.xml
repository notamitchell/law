    <body>
      <div type="clause" n="14">
        <head><ref type="lawCode" target="law:IIAs">II As</ref> 14</head>
        <ab type="selectedText" xml:lang="und">Be myneterum. Ðridda: þæt an mynet sy ofer eall ðæs cynges onweald ⁊ nan mon ne mynetige buton on port.</ab>
        <ab type="translation" xml:lang="en">Thirdly: we declare that there shall be one coinage throughout the king's realm, and no man shall mint money except in a town.</ab>
        <ab type="supplementaryText" xml:lang="und">Be myneterum. We cwædon, þæt án mynet sy ofer ealle ðæs cynges onwealde; ⁊ nán man ne mynetige butan port.</ab>
      </div>
    </body>
