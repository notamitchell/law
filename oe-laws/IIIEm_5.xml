  <text>
    <body>
      <div type="clause" n="5">
        <head><ref type="lawCode" target="law:IIIEm">III Em</ref> 5</head>
        <ab type="selectedText" xml:lang="und">Et nemo barganniet vel ignotum pecus recipiat qui non habeat testimonium summi praepositi vel sacerdotis vel hordarii vel portirevae.</ab>
        <ab type="translation" xml:lang="en">And no one shall make a purchase or receive strange cattle unless he has as witness the high-reeve or the priest or the treasurer or the town-reeve.</ab>
      </div>
