  <text>
    <body>
      <div type="clause" n="36">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 36</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="36" corresp="#wit-h">Gif sio uterre hion gebrocen worðeþ; X scillingum gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="36" corresp="#wit-h">Gif sio uterre hion gebrocen weorðeþ, X scillingum gebete.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">If the outer hion [?=covering of the skull] becomes broken, let him pay with 10 shillings.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">If the outer covering of the skull is broken, 10 shillings shall be paid as compensation.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn die äussere Hirn[..?] gebrochen wird, büsse er mit 10 Schillingen;</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If the outer brain-[..?] is broken, let him pay 10 shillings;</ab>
        <note type="comparedBy" source="#jurasinski-and-oliver" n="351"><ref target="clause:Af_44">Af 44–44.1</ref></note>
      </div>
    </body>
