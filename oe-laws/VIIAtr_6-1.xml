  <text>
    <body>
      <div type="clause" n="6.1">
        <head><ref type="lawCode" target="law:VIIAtr">VII Atr</ref> 6.1</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="6.1" corresp="#wit-q">Et sit omnis homo dignus iure publico, pauper et diues.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="6.1" corresp="#wit-q">Et sit omnis homo dignus iure publico, pauper et dives.</ab>
        <ab type="editionText" xml:lang="la" source="#rabin-doml" corresp="#wit-t">Et sit omnis homo dignus iure publico, pauper et dives.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q">And all men, whether poor or rich, shall be entitled to the benefit of the law.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-t">And all persons, poor or wealthy, are entitled to legal remedies.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Und jedermann geniesse Volksrecht, Arm und Reich.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let every man, poor and rich, be entitled to folk-right.</ab>
        <note type="comparison" source="#liebermann" n="261"><ref target="clause:VIAtr_8-1">VI Atr 8.1</ref></note>
        <note type="comparisonPrinted" source="#liebermann">ebd. 8, 1</note>
        <note type="editorial">Liebermann compares VI Atr 8.1.</note>
      </div>
