    <body>
      <div type="clause" n="2">
        <head>Wer 2</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-b">Gyf man ofslægen weorðe, gylde hine man swa he boren sy.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="2" corresp="#wit-q">Si homo occidatur, sicut natalis eius erit, persoluatur.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="2" corresp="#wit-h">Gif man ofslægen weorðe, gylde hine man swa he geboren sy.</ab>
        <ab type="translation" xml:lang="en" source="#wormald" corresp="#wit-h">If someone is killed, let him be paid for to whatever station he be born.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Wenn ein Mensch getödtet wird, werde er entgolten, je wie [hoch] er geboren ist.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">If a person is killed, let him be paid for according to how [high] he was born.</ab>
        <note type="editorial">Liebermann compares II Em 1.</note>
      </div>
    </body>
