  <text>
    <body>
      <div type="clause" n="33">
        <head><ref type="lawCode" target="law:VAtr">V Atr</ref> 33</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33" corresp="#wit-g">⁊ æghwylce unlaga alecge man georne.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="33" corresp="#wit-g2">⁊ æghwilce unlaga alecge man georne.</ab>
        <ab type="editionText" xml:lang="ang" source="#robertson" n="33" corresp="#wit-d">[⁊ æghwylce unlaga alecge man georne.] [G]</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-g">And æghwylce unlaga alecge man georne.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-d">[And injustice of every kind shall be zealously suppressed.]</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-g">And all injustice is to be utterly eradicated.</ab>
        <ab type="translation" xml:lang="en" source="#whitelock" corresp="#wit-g">And every abuse is to be zealously suppressed.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Und jegliches Unrecht beseitige man eifrig.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">And let every abuse be eagerly put down.</ab>
        <note type="comparison" source="#wormald-mel" n="333"><label>repeats</label> <ref target="clause:VAtr_32-5">V Atr 32.5</ref> <quote>the G texts ... at once repeat the same point in more or less the same words, V Atr 33, cf. 32:5</quote></note>
        <note type="editorial">Clause number standardised from ‘[33]’.</note>
        <note type="textual" source="#rabin-doml">omitted D</note>
      </div>
    </body>
  </text>
