        <head>Af Rb 22</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-h">XX. Be ðeofes ondettan.</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="22" corresp="#wit-e">XX. Be eofetes andetlan.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="22" corresp="#wit-q">De proclamatione ostensa.</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-e">XX Be eofetes andetlan</ab>
        <ab type="editionText" xml:lang="ang" source="#jurasinski-and-oliver" corresp="#wit-b">Be cynincges gerefan ðyfðe</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-e">Concerning the admission of an offense</ab>
        <ab type="translation" xml:lang="en" source="#jurasinski-and-oliver" corresp="#wit-b">Concerning theft by a king’s reeve</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Über Anzeige einer Missethat.</ab>
