        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="33" corresp="#wit-q"><pb n="23" ed="#liebermann"/>De regis<ptr type="liebermannNote" n="22" target="#Rubrics-Ine_33.lnote.oe.22"/> stabulario Walisco.</ab>
