      <div type="clause" n="4">
        <head><ref type="lawCode" target="law:Northu">Northu</ref> 4</head>
        <ab type="selectedText" xml:lang="und">Gif preost biscopes agen geban forbuge, gilde XX ór.</ab>
        <ab type="translation" xml:lang="en">If a priest neglects the the bisphop's own summons, he is to pay 20 ores.</ab>
        <ab type="secondTranslation" xml:lang="en">If a priest disregards a bishop's own decree, he is to pay twenty ores.</ab>
      </div>
