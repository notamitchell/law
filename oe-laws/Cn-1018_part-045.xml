    <body>
      <div type="clause" n="14.7">
        <head>Cn 1018 14.7</head>
        <ab type="editionText" xml:lang="ang" source="#kennedy" n="14.7" corresp="#wit-d">And fæste man ælce frigedæg. buton hit freols sy</ab>
        <ab type="editionText" xml:lang="ang" source="#rabin-doml" corresp="#wit-d">And fæste man ælce frigedæg, buton hit freols sy.</ab>
        <ab type="translation" xml:lang="en" source="#kennedy" corresp="#wit-d">And a fast shall be observed every Friday, unless it is a festival.</ab>
        <ab type="translation" xml:lang="en" source="#rabin-doml" corresp="#wit-d">And there shall be a fast each Friday unless it is a feast.</ab>
        <note type="comparedBy" source="#wormald-mel" n="314"><ref target="clause:IIEg_2-3">II Eg 2.3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="314"><ref target="clause:IIEg_5-1">II Eg 5.1–3</ref></note>
        <note type="comparedBy" source="#wormald-mel" n="314"><ref target="clause:IIIEg_8-1">III Eg 8.1–3</ref></note>
      </div>
