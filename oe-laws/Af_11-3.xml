    <body>
      <div type="clause" n="11.3">
        <head><ref type="lawCode" target="law:Af">Af</ref> 11.3</head>
        <ab type="selectedText" xml:lang="und">Gif oðer mon mid hire læge ær, sie be healfum ðæm þonne sio bot.</ab>
        <ab type="translation" xml:lang="en">If another man lay with her before, let the recompense be half.</ab>
        <ab type="secondTranslation" xml:lang="en">If another man has previously lain with her, that the compensation shall be half this [amount].</ab>
        <ab type="supplementaryText" xml:lang="und">Gif oðer mon mid hire læge ǽr, sy be healfum ðæm ðonne seo bot.</ab>
      </div>
    </body>
