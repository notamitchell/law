    <body>
      <div type="clause" n="6.2">
        <head><ref type="lawCode" target="law:IIIAtr">III Atr</ref> 6.2</head>
        <ab type="selectedText" xml:lang="und">⁊ gif he þæt ordal forfleo, gilde se borh hine be his were.</ab>
        <ab type="translation" xml:lang="en">And if he (the accused) flees from the ordeal, his surety shall pay for him to the amount of his [the fugitive's] wergeld.</ab>
        <ab type="supplementaryText" xml:lang="und">Et sit fugiet ab ordalio, reddat eum plegius wera sua.</ab>
      </div>
