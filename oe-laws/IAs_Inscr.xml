      <div type="clause" n="Inscr.">
        <head><ref type="lawCode" target="law:IAs">I As</ref> Inscr.</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="I As. Inscr." corresp="#wit-d">Æðelstanes cinyncges gerædnes</ab>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="I As. Inscr." corresp="#wit-g-b">Æðelstanes gerædnes.</ab>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="I As. Inscr." corresp="#wit-q">Incipiunt leges Æþelstani regis.</ab>
        <ab type="editionText" xml:lang="ang" source="#attenborough" corresp="#wit-g-b">Æðelstanes gerædnes.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-g-b">Athelstan's ordinance.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">König Aethelstans Verordnung.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">King Æthelstan's ordinance.</ab>
        <note type="editorial">Base text D = CCCC 201, f. 53 (c. 1060); G = Cotton Nero A I, f. 86 (c. 1080); Ld = Lambarde's Archaionomia (1568), f. 56, whose lost source Liebermann thinks was later than D and G.</note>
      </div>
