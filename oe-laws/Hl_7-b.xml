  <text>
    <body>
      <div type="clause" n="7[b]">
        <head><ref type="lawCode" target="law:Hl">Hl</ref> 7[b]</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="7[b]" corresp="#wit-h">gif he þ<hi rend="italic">æt</hi> ne mæge, læte án, ⁊ fo se agend tó.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="5.1" corresp="#wit-h">Gif he þ<hi rend="italic">æt</hi> ne mæge, læte án ⁊ fo se agend to.</ab>
        <ab type="translation" xml:lang="en" source="#oliver" corresp="#wit-h">If he is not able [to do] that, let him relinquish [it], and the owner take possession.</ab>
        <ab type="translation" xml:lang="en" source="#attenborough" corresp="#wit-h">If he cannot do that, he shall surrender it, and the owner shall take possession [of it].</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">wenn er das nicht kann, lasse er [es] los und greife der Eigenthümer zu.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">if he cannot do that, let him let [it] go and let the owner take hold of it.</ab>
      </div>
    </body>
