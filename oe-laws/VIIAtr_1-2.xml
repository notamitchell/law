    <body>
      <div type="clause" n="1.2">
        <head><ref type="lawCode" target="law:VIIAtr">VII Atr</ref> 1.2</head>
        <ab type="liebermannText" xml:lang="la" source="#liebermann" n="1.2" corresp="#wit-q">Hoc est ut detur de omni carruca denarius uel denarii ualens.</ab>
        <ab type="editionText" xml:lang="la" source="#robertson" n="1.2" corresp="#wit-q">Hoc est ut detur de omni carruca denarius vel denarii valens.</ab>
        <ab type="translation" xml:lang="en" source="#robertson" corresp="#wit-q">From every plough-land a penny or the value of a penny shall be given.</ab>
        <ab type="translation" xml:lang="de" source="#liebermann">Nämlich von jedem Pfluge [Landes] gebe man einen Pfennig oder Pfennigs Werth.</ab>
        <ab type="translation" xml:lang="en" source="#claude" ana="#fromGerman">Namely, from every plough[land] let a penny or a penny's worth be given.</ab>
        <note type="editorial">Liebermann compares VIIa Atr 2.2.</note>
      </div>
    </body>
