    <body>
      <div type="clause" n="65">
        <head><ref type="lawCode" target="law:Ine">Ine</ref> 65</head>
        <ab type="selectedText" xml:lang="und">{CVIIII} Se ðe hæfð X hida, se sceal tæcnan VI hida gesettes landes.</ab>
        <ab type="translation" xml:lang="en">He who has ten hides must show six cultivated hides.</ab>
        <ab type="secondTranslation" xml:lang="en">He who has [a holding of] 10 hides shall show 6 hides under cultivation.</ab>
        <ab type="supplementaryText" xml:lang="und">Se þe hæfð X hida londes, se sceal tæcan VI hida gesettes londes.</ab>
      </div>
