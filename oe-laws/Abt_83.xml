    <body>
      <div type="clause" n="83">
        <head><ref type="lawCode" target="law:Abt">Abt</ref> 83</head>
        <ab type="liebermannText" xml:lang="ang" source="#liebermann" n="83" corresp="#wit-h">Gif hio oþrum mæn in sceat bewyddod sy, XX scillinga gebete.</ab>
        <ab type="editionText" xml:lang="ang" source="#oliver" n="77.1" corresp="#wit-h">Gif hio oþrum mæn in sceat bewyddod sy, XX scillinga gebete.</ab>
        <ab type="translation" xml:lang="en" source="#oliver">If she should be betrothed to another man by goods [i.e., the bride-price has been paid], let him pay 20 shillings [to that man as well].</ab>
        <ab type="translation" xml:lang="en" source="#attenborough">If she is betrothed, at a price, to another man, 20 shillings shall be paid as compensation.</ab>
      </div>
